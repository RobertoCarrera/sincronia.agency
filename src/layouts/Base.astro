---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SEO from '~/components/SEO.astro';
import { nap, openingHoursSpecification } from '~/data/nap';
import { locations } from '~/data/locations';
import { getLocaleFromUrl } from '~/lib/i18n';
import { localeHtmlLang, type Locale } from '~/i18n/locales';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonical?: string;
  jsonLd?: object | object[];
}

const { title, description, ogImage, ogType, noindex, canonical, jsonLd } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;

// LocalBusiness schema — presente en TODAS las páginas para SEO local
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://sincronia.agency/#business',
  name: nap.name,
  alternateName: nap.shortName,
  description: 'Agencia técnica de diseño, desarrollo y SEO en Tarragona. WordPress, Angular, SEO local y hosting.',
  url: nap.url,
  telephone: nap.phone,
  email: nap.email,
  priceRange: nap.priceRange,
  image: 'https://sincronia.agency/logos/sincronia-logo-bg.png',
  logo: 'https://sincronia.agency/logos/sincronia-logo-bg.png',
  address: {
    '@type': 'PostalAddress',
    streetAddress: nap.street,
    addressLocality: nap.city,
    addressRegion: nap.region,
    postalCode: nap.postalCode,
    addressCountry: nap.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: nap.geo.lat,
    longitude: nap.geo.lng,
  },
  openingHoursSpecification,
  areaServed: locations.map((l) => ({ '@type': 'City', name: l.name })),
};

const allSchemas = jsonLd ? [...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]), localBusiness] : [localBusiness];
---
<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <SEO
      title={title}
      description={description}
      locale={locale}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      canonical={canonical}
      jsonLd={allSchemas}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
