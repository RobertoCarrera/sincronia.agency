---
/**
 * Button — dos estilos según destino:
 *   - internal (default): icono chevron `>` que se desplaza a la derecha en hover
 *   - external: icono de flecha diagonal con animación estilo Uiverse
 *     (dos SVGs superpuestos, en hover uno sale y entra el otro)
 *
 * Colores de marca: primary = coral, secondary = navy.
 * Border-radius: internal = 10px (design system), external = pill (10rem).
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** false = link interno (icono `>`); true = link externo (icono animado). */
  external?: boolean;
  className?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const {
  href,
  type,
  variant = 'primary',
  size = 'md',
  external = false,
  className = '',
  ariaLabel,
  disabled,
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  size === 'lg' ? 'btn--lg' : null,
  external ? 'btn--external' : 'btn--internal',
  className,
].filter(Boolean).join(' ');

const palettes: Record<string, string> = {
  primary: 'var(--c-coral-500)',
  secondary: 'var(--c-navy-800)',
  ghost: 'transparent',
};
const bg = palettes[variant] ?? palettes.primary;

const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a class={classes} href={href} style={`--btn-bg: ${bg}`} aria-label={ariaLabel} {...linkAttrs}>
    <slot />
    {external ? (
      <span class="btn__icon-wrap btn__icon-wrap--external" aria-hidden="true">
        <svg viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" width="10" class="btn__icon-svg">
          <path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path>
        </svg>
        <svg viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg" width="10" class="btn__icon-svg btn__icon-svg--copy">
          <path d="M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z" fill="currentColor"></path>
        </svg>
      </span>
    ) : (
      <span class="btn__icon-wrap btn__icon-wrap--internal" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </span>
    )}
  </a>
) : (
  <button class={classes} style={`--btn-bg: ${bg}`} type={type ?? 'button'} aria-label={ariaLabel} disabled={disabled}>
    <slot />
    <span class="btn__icon-wrap btn__icon-wrap--internal" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </span>
  </button>
)}

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    color: #fff;
    background-color: var(--btn-bg, var(--c-coral-500));
    border: 0;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .btn:focus-visible { outline: 3px solid var(--c-coral-500); outline-offset: 3px; }
  .btn--lg { padding: 1rem 2rem; font-size: 1rem; }
  .btn--secondary { background-color: var(--c-navy-800); }
  .btn--secondary:hover { background-color: var(--c-navy-700); }
  .btn--primary:hover { background-color: var(--c-coral-600); }
  .btn--ghost {
    background-color: transparent;
    color: var(--c-navy-800);
    border: 1px solid var(--c-line);
  }
  .btn--ghost:hover {
    background-color: var(--c-bg-alt);
    border-color: var(--c-navy-800);
  }

  /* === Icono "internal" (chevron) === */
  .btn__icon-wrap--internal {
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s;
  }
  .btn__icon-wrap--internal svg { width: 1rem; height: 1rem; }
  .btn:hover .btn__icon-wrap--internal { transform: translateX(3px); }

  /* === Icono "external" (estilo Uiverse) === */
  .btn--external {
    line-height: 1;
    text-decoration: none;
    display: inline-flex;
    border: none;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--btn-bg, var(--c-coral-500));
    color: #fff;
    border-radius: 10rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    padding-left: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background-color 0.3s;
  }
  .btn--external.btn--lg {
    padding: 1rem 2rem;
    padding-left: 28px;
  }
  .btn__icon-wrap--external {
    flex-shrink: 0;
    width: 25px;
    height: 25px;
    position: relative;
    color: var(--btn-bg, var(--c-coral-500));
    background-color: #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .btn--external.btn--lg .btn__icon-wrap--external { width: 32px; height: 32px; }
  .btn__icon-wrap--external .btn__icon-svg { width: 10px; height: 10px; }
  .btn__icon-wrap--external .btn__icon-svg--copy {
    position: absolute;
    transform: translate(-150%, 150%);
  }
  .btn--external:hover { background-color: var(--c-ink); }
  .btn--external:hover .btn__icon-wrap--external { color: var(--c-ink); }
  .btn--external:hover .btn__icon-svg:first-child {
    transition: transform 0.3s ease-in-out;
    transform: translate(150%, -150%);
  }
  .btn--external:hover .btn__icon-svg--copy {
    transition: transform 0.3s ease-in-out 0.1s;
    transform: translate(0);
  }
</style>
