---
/**
 * Button — estilo Uiverse con bolita circular blanca e icono animado.
 *
 *   - internal (default): icono `>` que se desplaza con la misma animación
 *     (sale volando y entra la copia). Para links internos.
 *   - external: flecha diagonal (mismo path de Uiverse). Para links a webs externas.
 *     Abre en nueva pestaña con target="_blank" rel="noopener noreferrer".
 *
 * Colores de marca: primary = coral, secondary = navy. Border-radius: pill (10rem).
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** true = link externo (flecha diagonal + nueva pestaña). false = link interno (`>`). */
  external?: boolean;
  className?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const {
  href,
  type,
  variant = 'primary',
  size = 'md',
  external = false,
  className = '',
  ariaLabel,
  disabled,
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  size === 'lg' ? 'btn--lg' : null,
  className,
].filter(Boolean).join(' ');

const palettes: Record<string, string> = {
  primary: 'var(--c-coral-500)',
  secondary: 'var(--c-navy-800)',
  ghost: 'transparent',
};
const bg = palettes[variant] ?? palettes.primary;

const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// Path del chevron `>` (usado en internal)
const chevronPath = 'm9 18 6-6-6-6';
// Path de la flecha diagonal (usado en external — Uiverse)
const arrowPath = 'M13.376 11.552l-.264-10.44-10.44-.24.024 2.28 6.96-.048L.2 12.56l1.488 1.488 9.432-9.432-.048 6.912 2.304.024z';
---

{href ? (
  <a class={classes} href={href} style={`--clr: ${bg}`} aria-label={ariaLabel} {...linkAttrs}>
    <slot />
    <span class="btn__icon-wrapper" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        class={`btn__icon-svg ${external ? 'btn__icon-svg--external' : 'btn__icon-svg--internal'}`}
      >
        {external ? (
          <path d={arrowPath} fill="currentColor" stroke="none"></path>
        ) : (
          <path d={chevronPath}></path>
        )}
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        class={`btn__icon-svg btn__icon-svg--copy ${external ? 'btn__icon-svg--external' : 'btn__icon-svg--internal'}`}
      >
        {external ? (
          <path d={arrowPath} fill="currentColor" stroke="none"></path>
        ) : (
          <path d={chevronPath}></path>
        )}
      </svg>
    </span>
  </a>
) : (
  <button class={classes} style={`--clr: ${bg}`} type={type ?? 'button'} aria-label={ariaLabel} disabled={disabled}>
    <slot />
    <span class="btn__icon-wrapper" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        class="btn__icon-svg"
      >
        <path d={chevronPath}></path>
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        class="btn__icon-svg btn__icon-svg--copy"
      >
        <path d={chevronPath}></path>
      </svg>
    </span>
  </button>
)}

<style is:global>
  /* === Base estilo Uiverse (pill + bolita) === */
  .btn {
    line-height: 1;
    text-decoration: none;
    display: inline-flex;
    border: none;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--clr, var(--c-coral-500));
    color: #fff;
    border-radius: 10rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    padding-left: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background-color 0.3s, color 0.3s;
  }
  .btn--lg {
    padding: 1rem 2rem;
    padding-left: 28px;
  }
  .btn:focus-visible { outline: 3px solid var(--c-coral-500); outline-offset: 3px; }
  .btn:hover {
    background-color: var(--c-ink);
    color: #fff;
  }
  .btn--ghost {
    background-color: transparent;
    color: var(--c-navy-800);
    border: 1px solid var(--c-line);
  }
  .btn--ghost:hover {
    background-color: var(--c-bg-alt);
    color: var(--c-navy-800);
    border-color: var(--c-navy-800);
  }

  /* === Bolita blanca con el icono (animado) === */
  .btn__icon-wrapper {
    flex-shrink: 0;
    width: 25px;
    height: 25px;
    position: relative;
    color: var(--clr, var(--c-coral-500));
    background-color: #fff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .btn--lg .btn__icon-wrapper { width: 32px; height: 32px; }
  .btn__icon-svg {
    display: block;
  }
  .btn__icon-svg--internal {
    width: 14px;
    height: 14px;
  }
  .btn__icon-svg--external {
    width: 10px;
    height: 10px;
  }
  .btn__icon-svg--copy {
    position: absolute;
    transform: translate(-150%, 150%);
  }

  /* === Hover: el icono sale volando y la copia entra desde fuera === */
  .btn:hover .btn__icon-wrapper { color: var(--c-ink); }
  .btn:hover .btn__icon-svg:first-child {
    transition: transform 0.3s ease-in-out;
    transform: translate(150%, -150%);
  }
  .btn:hover .btn__icon-svg--copy {
    transition: transform 0.3s ease-in-out 0.1s;
    transform: translate(0);
  }
</style>
