---
/**
 * Button — wrapper de BorderGlow con la estética del design system.
 *
 * Estructura:
 *   <a class="border-glow-card btn-wrap btn-wrap--primary" href="...">
 *     <span class="edge-light"></span>
 *     <div class="border-glow-inner">
 *       <span class="btn__label">label</span>
 *     </div>
 *   </a>
 *
 * El wrapper BorderGlow controla background, border mesh y glow.
 * El padding se aplica al .border-glow-inner (no al <a>), para que
 * los pseudo-elementos del mesh puedan ocupar el border-box real.
 *
 * Si pasas `flat`, es un botón .btn sin glow.
 */
import BorderGlow from '~/components/BorderGlow.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  className?: string;
  ariaLabel?: string;
  disabled?: boolean;
  /** Sin BorderGlow. */
  flat?: boolean;
}

const {
  href,
  type,
  variant = 'primary',
  size = 'md',
  className = '',
  ariaLabel,
  disabled,
  flat = false,
} = Astro.props;

const wrapClasses = [
  'btn-wrap',
  `btn-wrap--${variant}`,
  size === 'lg' ? 'btn-wrap--lg' : null,
  className,
].filter(Boolean).join(' ');

const innerClasses = [
  'btn',
  `btn--${variant}`,
  size === 'lg' ? 'btn--lg' : null,
  'btn--glow-inner',
].filter(Boolean).join(' ');

const palettes = {
  primary: {
    bg: '#FF7A4D',
    glow: '14 90 65',
    colors: ['#1B3A6B', '#FFE0D2', '#D85A2A'],
  },
  secondary: {
    bg: '#1B3A6B',
    glow: '215 80 55',
    colors: ['#FF7A4D', '#0E2347', '#284F8E'],
  },
  ghost: {
    bg: '#ffffff',
    glow: '14 80 60',
    colors: ['#1B3A6B', '#FF7A4D', '#FFE0D2'],
  },
} as const;
const palette = palettes[variant];
---

{flat ? (
  href ? (
    <a class={innerClasses.replace(' btn--glow-inner', '')} href={href} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button class={innerClasses.replace(' btn--glow-inner', '')} type={type ?? 'button'} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
) : href ? (
  <BorderGlow
    href={href}
    className={wrapClasses}
    backgroundColor={palette.bg}
    glowColor={palette.glow}
    borderRadius={size === 'lg' ? 14 : 10}
    glowRadius={22}
    edgeSensitivity={45}
    fillOpacity={0.4}
    colors={[...palette.colors]}
  >
    <span class="btn__label"><slot /></span>
  </BorderGlow>
) : (
  <BorderGlow
    className={wrapClasses}
    backgroundColor={palette.bg}
    glowColor={palette.glow}
    borderRadius={size === 'lg' ? 14 : 10}
    glowRadius={22}
    edgeSensitivity={45}
    fillOpacity={0.4}
    colors={[...palette.colors]}
  >
    <button class={innerClasses} type={type ?? 'button'} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  </BorderGlow>
)}

<style is:global>
  /* El padding y el layout van en el inner, no en el wrapper, para
     no romper la técnica del border mesh (que necesita que el
     wrapper no tenga padding). */
  .btn-wrap :global(.border-glow-inner) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    width: 100%;
    transition: transform 0.2s ease;
  }
  .btn-wrap--lg :global(.border-glow-inner) {
    padding: 1rem 2rem;
    font-size: 1rem;
  }
  .btn-wrap--ghost :global(.border-glow-inner) {
    color: var(--c-navy-800);
  }
  .btn-wrap:hover :global(.border-glow-inner) {
    transform: translateY(-1px);
  }

  /* El <button> interior: en ghost no debe tener background porque
     el wrapper ya lo aporta. */
  .btn--glow-inner {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    padding: 0;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: inherit;
  }
  .btn--glow-inner:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    border-radius: inherit;
  }
</style>
