---
import Logo from '~/components/Logo.astro';
import LangSwitcher from '~/components/LangSwitcher.astro';
import MegaMenu from '~/components/MegaMenu.astro';
import Button from '~/components/Button.astro';
import { t, type UIKey } from '~/i18n/ui';
import { getLocaleFromUrl, getPathWithoutLocale, localizePath } from '~/lib/i18n';
import { services } from '~/data/services';
import { products } from '~/data/products';
import type { Locale } from '~/i18n/locales';

const locale = getLocaleFromUrl(Astro.url) as Locale;
const currentPath = Astro.url.pathname;

type NavItem =
  | { kind: 'link'; href: string; labelKey: UIKey; match: 'exact' | 'prefix' }
  | { kind: 'mega'; href: string; labelKey: UIKey; mega: 'services' | 'products'; match: 'prefix' };

const navItems: NavItem[] = [
  // "Inicio" no se muestra: el logo (Sincronia) ya enlaza a /, sería redundante.
  { kind: 'mega', href: localizePath('/servicios', locale), labelKey: 'nav.services', mega: 'services', match: 'prefix' },
  { kind: 'mega', href: localizePath('/productos', locale), labelKey: 'nav.products', mega: 'products', match: 'prefix' },
  { kind: 'link', href: localizePath('/sobre-nosotros', locale), labelKey: 'nav.about', match: 'prefix' },
  { kind: 'link', href: localizePath('/contacto', locale), labelKey: 'nav.contact', match: 'prefix' },
];

const isActive = (item: NavItem): boolean => {
  if (item.match === 'exact') return currentPath === item.href;
  return currentPath.startsWith(item.href);
};

// Submenús mobile para los items con mega. Reusan la misma data
// que el MegaMenu de desktop pero renderizados como lista simple.
const statusLabel: Record<'alpha' | 'beta' | 'estable', string> = {
  alpha: 'ALPHA',
  beta: 'BETA',
  estable: 'ESTABLE',
};

const megaSubmenus: Record<'services' | 'products', Array<{
  href: string;
  label: string;
  description: string;
  badge?: string;
}>> = {
  services: services.map((s) => ({
    href: localizePath(`/servicios/${s.slug}`, locale),
    label: s.title,
    description: s.shortDescription[locale],
  })),
  products: products.map((p) => ({
    href: localizePath(`/productos/${p.slug}`, locale),
    label: p.name,
    description: p.shortDescription[locale],
    badge: p.status !== 'estable' ? statusLabel[p.status] : undefined,
  })),
};

const expandLabel: Record<Locale, string> = {
  es: 'Expandir submenú',
  ca: 'Expandir submenú',
  en: 'Expand submenu',
};
---
<header class="site-header" data-header>
  <!-- Top bar NAP: ubicación · teléfono · horario + status pill -->
  <div class="site-header__topbar" aria-label="Información de contacto">
    <div class="container site-header__topbar-inner">
      <ul class="site-header__topbar-info">
        <li>
          <a
            class="site-header__topbar-item"
            href="https://www.google.com/maps/search/?api=1&query=Segur+de+Calafell+Tarragona"
            target="_blank"
            rel="noopener"
            aria-label="Abrir ubicación en Google Maps"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Segur de Calafell · Tarragona</span>
          </a>
        </li>
        <li>
          <a class="site-header__topbar-item" href="tel:+34624344917" aria-label="Llamar a Sincronia">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.95.37 1.88.72 2.78a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.11-.45c.9.35 1.83.59 2.78.72A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>+34 624 34 49 17</span>
          </a>
        </li>
        <li class="site-header__topbar-item site-header__topbar-item--static">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Lun–Dom · 7:00–24:00</span>
        </li>
      </ul>
      <span class="site-header__status" aria-label="Disponibilidad actual">
        <span class="site-header__status-dot" aria-hidden="true"></span>
        Aceptando proyectos
      </span>
    </div>
  </div>

  <!-- Main bar: logo + nav + acciones (escritorio) + toggle (móvil) -->
  <div class="site-header__main">
    <div class="container site-header__main-inner">
      <Logo />

      <nav class="main-nav" aria-label="Navegación principal">
        <ul class="main-nav__list">
          {navItems.map((item) => (
            <li
              class:list={[
                'main-nav__item',
                item.kind === 'mega' && 'has-mega',
                isActive(item) && 'is-active',
              ]}
              data-mega-trigger={item.kind === 'mega' ? item.mega : undefined}
            >
              {item.kind === 'mega' ? (
                <>
                  <div class="main-nav__item-head">
                    <a
                      href={item.href}
                      class="main-nav__link"
                      aria-current={isActive(item) ? 'page' : undefined}
                    >
                      <span>{t(locale, item.labelKey)}</span>
                      {/* Chevron integrado en el link: solo visible en desktop */}
                      <svg class="main-nav__chevron main-nav__chevron--inline" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </a>
                    {/* Botón expand: solo visible en mobile, toggle del submenu */}
                    <button
                      type="button"
                      class="main-nav__expand"
                      aria-label={expandLabel[locale]}
                      aria-expanded="false"
                      aria-controls={`submenu-${item.mega}`}
                      data-mobile-expand={item.mega}
                    >
                      <svg class="main-nav__chevron main-nav__chevron--mobile" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </button>
                  </div>
                  {/* Submenú mobile: lista de items del mega menu */}
                  <ul
                    id={`submenu-${item.mega}`}
                    class="main-nav__submenu"
                    role="menu"
                    aria-label={t(locale, item.labelKey)}
                    data-mobile-submenu={item.mega}
                    hidden
                  >
                    {megaSubmenus[item.mega].map((sub) => (
                      <li role="none">
                        <a href={sub.href} role="menuitem" class="main-nav__submenu-link">
                          <span class="main-nav__submenu-label">
                            {sub.label}
                            {sub.badge && (
                              <span class:list={['main-nav__submenu-badge', `main-nav__submenu-badge--${sub.badge.toLowerCase()}`]}>
                                {sub.badge}
                              </span>
                            )}
                          </span>
                          <span class="main-nav__submenu-desc">{sub.description}</span>
                        </a>
                      </li>
                    ))}
                    <li role="none" class="main-nav__submenu-foot">
                      <a href={item.href} class="main-nav__submenu-all">
                        {item.mega === 'services'
                          ? (locale === 'en' ? 'View all services' : locale === 'ca' ? 'Veure tots els serveis' : 'Ver todos los servicios')
                          : (locale === 'en' ? 'View all products' : locale === 'ca' ? 'Veure tots els productes' : 'Ver todos los productos')}
                      </a>
                    </li>
                  </ul>
                </>
              ) : (
                <a
                  href={item.href}
                  class="main-nav__link"
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  <span>{t(locale, item.labelKey)}</span>
                </a>
              )}
            </li>
          ))}
        </ul>

        <!-- Footer del drawer: solo visible en móvil, al final de la nav.
             Selector de idioma inline (3 botones) en lugar de dropdown para
             evitar problemas de overflow/clip dentro del drawer. -->
        <div class="main-nav__drawer-footer">
          <div class="lang-inline" role="group" aria-label={t(locale, 'lang.switcher')}>
            {(['es', 'ca', 'en'] as Locale[]).map((loc) => (
              <a
                href={localizePath(getPathWithoutLocale(Astro.url.pathname), loc)}
                class:list={['lang-inline__btn', loc === locale && 'is-current']}
                aria-current={loc === locale ? 'true' : undefined}
              >
                {loc.toUpperCase()}
              </a>
            ))}
          </div>
          <Button href={localizePath('/contacto', locale)} variant="primary" className="drawer-cta">
            {t(locale, 'cta.quote')}
          </Button>
        </div>
      </nav>

      <div class="site-header__actions">
        <LangSwitcher />
        <Button href={localizePath('/contacto', locale)} variant="primary" className="main-cta">
          {t(locale, 'cta.quote')}
        </Button>
      </div>

      <button class="site-header__toggle" type="button" aria-label="Abrir menú" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Overlay oscuro detrás del drawer mobile -->
  <div class="site-header__overlay" data-nav-overlay aria-hidden="true"></div>

  <!-- Mega menus a nivel de header para que se posicionen full-width con left:0/right:0 -->
  <MegaMenu type="services" locale={locale} />
  <MegaMenu type="products" locale={locale} />
</header>

<style>
  /* ============================================================
     Header: sticky con dos filas (top bar NAP + main bar)
     ============================================================ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    transition: box-shadow 0.2s;
  }
  :global(.site-header.is-scrolled) {
    box-shadow: 0 4px 16px -4px rgba(11, 18, 32, 0.08);
  }

  /* --- Top bar (NAP + status pill) ---------------------------- */
  .site-header__topbar {
    background: var(--c-navy-900);
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.8125rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-header__topbar-inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 36px;
    padding-block: 0.4rem;
  }
  .site-header__topbar-info {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
  }
  .site-header__topbar-info > li {
    display: inline-flex;
  }
  .site-header__topbar-info > li + li::before {
    content: '·';
    margin: 0 0.85rem;
    color: rgba(255, 255, 255, 0.25);
  }
  .site-header__topbar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.15s;
    padding: 0.15rem 0;
  }
  a.site-header__topbar-item:hover { color: #fff; }
  .site-header__topbar-item svg {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* Status pill "Aceptando proyectos" */
  .site-header__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(76, 217, 123, 0.12);
    color: #5FE39A;
    padding: 0.25rem 0.7rem;
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .site-header__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5FE39A;
    box-shadow: 0 0 0 0 rgba(95, 227, 154, 0.6);
    animation: site-status-pulse 2s infinite;
  }
  @keyframes site-status-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(95, 227, 154, 0.6); }
    50% { box-shadow: 0 0 0 6px rgba(95, 227, 154, 0); }
  }

  /* --- Main bar (logo + nav + acciones) ---------------------- */
  .site-header__main {
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--c-line);
    transition: background 0.2s, border-color 0.2s;
  }
  :global(.site-header.is-scrolled) .site-header__main {
    background: rgba(255, 255, 255, 0.92);
  }
  .site-header__main-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-3);
    min-height: 64px;
  }

  /* --- Nav (links + mega triggers) --------------------------- */
  .main-nav { display: none; flex: 1; justify-content: center; }
  .main-nav__list { list-style: none; display: flex; align-items: center; gap: 0.25rem; }

  .main-nav__item { position: relative; }
  .main-nav__item-head {
    /* En desktop, el row contiene link + botón expand, pero el botón está
       oculto y el link se ve normal. En mobile, ambos se muestran lado a lado. */
    display: flex;
    align-items: stretch;
  }
  .main-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.95rem;
    border-radius: var(--r-md);
    color: var(--c-text);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.15s, background 0.15s;
  }
  .main-nav__link:hover { color: var(--c-ink); background: var(--c-bg-alt); }
  .main-nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    width: calc(100% - 1.9rem);
    height: 2px;
    background: var(--c-coral-500);
    border-radius: 2px 2px 0 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .main-nav__item.is-active .main-nav__link { color: var(--c-ink); }
  .main-nav__item.is-active .main-nav__link::after { transform: translateX(-50%) scaleX(1); }
  :global(.has-mega[data-mega-open="true"]) > .main-nav__item-head > .main-nav__link { color: var(--c-ink); background: var(--c-bg-alt); }
  :global(.has-mega[data-mega-open="true"]) > .main-nav__item-head > .main-nav__link::after { transform: translateX(-50%) scaleX(1); }

  .main-nav__chevron {
    width: 0.875rem;
    height: 0.875rem;
    color: currentColor;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Chevron integrado en el link: solo visible en desktop */
  .main-nav__chevron--inline { display: inline-block; }
  /* Chevron del botón expand: solo visible en mobile */
  .main-nav__chevron--mobile { display: none; }
  :global(.has-mega[data-mega-open="true"]) .main-nav__chevron--inline { transform: rotate(180deg); }

  /* Botón expand: oculto en desktop */
  .main-nav__expand { display: none; }
  /* Submenú: oculto siempre por defecto, se muestra en mobile via JS */
  .main-nav__submenu { display: none; }

  /* --- Actions (lang + CTA) --------------------------------- */
  .site-header__actions { display: flex; align-items: center; gap: var(--s-3); }
  .site-header__actions .main-cta { display: none; }

  /* Footer dentro del drawer (oculto en escritorio) */
  .main-nav__drawer-footer {
    display: none;
  }

  /* --- Mobile toggle ---------------------------------------- */
  .site-header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: var(--c-bg-alt);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    padding: 0;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  .site-header__toggle:hover {
    background: #fff;
    border-color: var(--c-coral-300);
  }
  .site-header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-ink);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.2s;
  }
  :global(.site-header.is-nav-open) .site-header__toggle {
    background: var(--c-navy-900);
    border-color: var(--c-navy-900);
  }
  :global(.site-header.is-nav-open) .site-header__toggle span { background: #fff; }
  :global(.site-header.is-nav-open) .site-header__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  :global(.site-header.is-nav-open) .site-header__toggle span:nth-child(2) { opacity: 0; }
  :global(.site-header.is-nav-open) .site-header__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Overlay oscuro detrás del drawer en mobile */
  .site-header__overlay {
    display: none;
  }
  :global(.site-header.is-nav-open) .site-header__overlay {
    display: block;
    position: fixed;
    inset: 0;
    top: 100%; /* justo debajo del header */
    background: rgba(11, 18, 32, 0.5);
    z-index: 35;
    animation: site-overlay-fade 0.2s ease;
  }
  @keyframes site-overlay-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* --- Breakpoints ------------------------------------------ */
  @media (min-width: 1024px) {
    .main-nav { display: flex; }
    .site-header__toggle { display: none; }
    .site-header__actions .main-cta { display: inline-flex; }
  }

  /* Móvil: ocultar la top bar NAP completa. La nav inferior
     ya da acceso a contacto y el hamburger lo abre todo. */
  @media (max-width: 767.98px) {
    .site-header__topbar { display: none; }
  }

  /* Móvil: nav drawer */
  @media (max-width: 1023.98px) {
    /* En móvil solo logo + toggle en el header. Las acciones (lang + CTA)
       se mueven al final del drawer para no saturar la barra. */
    .site-header__actions { display: none; }
    .site-header__main-inner { gap: var(--s-3); }
    .logo img { max-width: 140px; }

    :global(.site-header.is-nav-open) .main-nav {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--c-line);
      box-shadow: 0 8px 24px -4px rgba(11, 18, 32, 0.12);
      z-index: 39;
      animation: site-drawer-slide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.site-header.is-nav-open) .main-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* Padding más compacto para que el drawer no sea tan alto. */
      padding: var(--s-2) var(--s-2) 0;
    }
    :global(.site-header.is-nav-open) .main-nav__item { width: 100%; }

    /* En mobile: el item-head (link + botón expand) se ve en fila */
    :global(.site-header.is-nav-open) .main-nav__item-head {
      display: flex;
      align-items: stretch;
      gap: 0.25rem;
    }
    :global(.site-header.is-nav-open) .main-nav__link {
      flex: 1;
      min-width: 0;
      padding: var(--s-2) var(--s-3);
      border-radius: var(--r-md);
    }
    :global(.site-header.is-nav-open) .main-nav__link::after { display: none; }
    /* En mobile el chevron integrado se oculta — lo muestra el botón expand */
    :global(.site-header.is-nav-open) .main-nav__chevron--inline { display: none; }
    /* En mobile el chevron del botón SÍ se muestra */
    :global(.site-header.is-nav-open) .main-nav__chevron--mobile { display: inline-block; }

    /* Botón expand: 44×44 táctil, al lado del link */
    :global(.site-header.is-nav-open) .main-nav__expand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      flex-shrink: 0;
      background: var(--c-bg-alt);
      border: 1px solid var(--c-line);
      border-radius: var(--r-md);
      padding: 0;
      cursor: pointer;
      color: var(--c-ink);
      transition: background 0.15s, border-color 0.15s;
    }
    :global(.site-header.is-nav-open) .main-nav__expand:hover {
      border-color: var(--c-coral-300);
    }
    /* Chevron rota cuando el submenu está expandido */
    :global(.site-header.is-nav-open) .main-nav__expand[aria-expanded="true"] {
      background: var(--c-coral-500);
      border-color: var(--c-coral-500);
      color: #fff;
    }
    :global(.site-header.is-nav-open) .main-nav__expand[aria-expanded="true"] .main-nav__chevron {
      transform: rotate(180deg);
    }

    /* Submenú mobile: lista vertical con animación slide-down */
    :global(.site-header.is-nav-open) .main-nav__submenu {
      display: block;
      list-style: none;
      margin: 0.25rem 0 0.5rem 0;
      padding: 0;
      background: var(--c-bg-alt);
      border-radius: var(--r-md);
      overflow: hidden;
      animation: site-submenu-slide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.site-header.is-nav-open) .main-nav__submenu[hidden] { display: none; }
    :global(.site-header.is-nav-open) .main-nav__submenu li { margin: 0; }
    :global(.site-header.is-nav-open) .main-nav__submenu li + li { border-top: 1px solid var(--c-line); }

    :global(.site-header.is-nav-open) .main-nav__submenu-link {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: var(--s-3);
      color: var(--c-text);
      text-decoration: none;
      transition: background 0.15s;
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-link:hover {
      background: #fff;
      color: var(--c-text);
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-label {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--c-ink);
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-desc {
      color: var(--c-muted);
      font-size: 0.78rem;
      line-height: 1.35;
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-badge {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: #fff;
      padding: 0.1rem 0.35rem;
      border-radius: var(--r-sm);
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-badge--alpha { background: var(--c-navy-800); }
    :global(.site-header.is-nav-open) .main-nav__submenu-badge--beta { background: var(--c-coral-500); }
    :global(.site-header.is-nav-open) .main-nav__submenu-foot {
      border-top: 1px solid var(--c-line) !important;
      background: #fff;
    }
    :global(.site-header.is-nav-open) .main-nav__submenu-all {
      display: block;
      padding: var(--s-3);
      text-align: center;
      color: var(--c-navy-800);
      font-weight: 600;
      font-size: 0.85rem;
    }

    /* Mega menu de desktop: oculto en mobile (el submenú inline hace su trabajo) */
    :global(.site-header .mega-menu) { display: none !important; }

    /* Footer del drawer: lang inline + CTA en la parte de abajo, más compacto */
    :global(.site-header.is-nav-open) .main-nav__drawer-footer {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-2) var(--s-3);
      margin-top: var(--s-2);
      border-top: 1px solid var(--c-line);
      background: var(--c-bg-alt);
    }
    :global(.site-header.is-nav-open) .main-nav__drawer-footer .drawer-cta {
      flex: 1;
      justify-content: center;
    }

    /* Selector de idioma inline (3 botones ES/CA/EN), solo en mobile drawer */
    :global(.site-header.is-nav-open) .lang-inline {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.25rem;
      background: #fff;
      border: 1px solid var(--c-line);
      border-radius: var(--r-md);
      flex-shrink: 0;
    }
    :global(.site-header.is-nav-open) .lang-inline__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--c-text);
      border-radius: var(--r-sm);
      transition: background 0.15s, color 0.15s;
    }
    :global(.site-header.is-nav-open) .lang-inline__btn:hover { background: var(--c-bg-alt); }
    :global(.site-header.is-nav-open) .lang-inline__btn.is-current {
      background: var(--c-navy-900);
      color: #fff;
    }
  }
  @keyframes site-submenu-slide {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes site-drawer-slide {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Scroll-aware header (background strengthen on scroll)
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          header.classList.toggle('is-scrolled', window.scrollY > 8);
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Mobile nav toggle
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
  toggle?.addEventListener('click', () => {
    header?.classList.toggle('is-nav-open');
  });
  // Click en el overlay cierra el drawer
  overlay?.addEventListener('click', () => {
    header?.classList.remove('is-nav-open');
  });

  // Mobile submenu acordeón: click en el botón expand toggle el submenu.
  // Acordeón: solo un submenu abierto a la vez.
  const expandButtons = document.querySelectorAll<HTMLButtonElement>('[data-mobile-expand]');
  expandButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const type = btn.getAttribute('data-mobile-expand');
      if (!type) return;
      const submenu = document.querySelector<HTMLElement>(`[data-mobile-submenu="${type}"]`);
      const trigger = document.querySelector<HTMLElement>(`[data-mega-trigger="${type}"]`);
      if (!submenu || !trigger) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      // Cerrar todos los submenus primero
      expandButtons.forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const t = b.getAttribute('data-mobile-expand');
        if (t) {
          const sm = document.querySelector<HTMLElement>(`[data-mobile-submenu="${t}"]`);
          const tr = document.querySelector<HTMLElement>(`[data-mega-trigger="${t}"]`);
          if (sm) sm.hidden = true;
          if (tr) tr.removeAttribute('data-mega-open');
        }
      });
      // Abrir el actual si estaba cerrado
      if (!isOpen) {
        submenu.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        trigger.setAttribute('data-mega-open', 'true');
      }
    });
  });

  // Mega menu hover with delay (desktop only)
  const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
  if (isDesktop) {
    const triggers = document.querySelectorAll<HTMLElement>('[data-mega-trigger]');
    let openTimer: number | undefined;
    let closeTimer: number | undefined;

    const closeAll = () => {
      document.querySelectorAll<HTMLElement>('[data-mega-trigger]').forEach((t) => {
        t.removeAttribute('data-mega-open');
        const btn = t.querySelector<HTMLButtonElement>('[data-mobile-expand]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll<HTMLElement>('[data-mega-menu]').forEach((m) => {
        m.removeAttribute('data-mega-open');
        m.hidden = true;
      });
    };

    const open = (type: string) => {
      closeAll();
      const trigger = document.querySelector<HTMLElement>(`[data-mega-trigger="${type}"]`);
      const btn = trigger?.querySelector<HTMLButtonElement>('[data-mobile-expand]');
      const menu = document.querySelector<HTMLElement>(`[data-mega-menu="${type}"]`);
      if (!menu || !btn || !trigger) return;
      trigger.setAttribute('data-mega-open', 'true');
      menu.setAttribute('data-mega-open', 'true');
      btn.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
    };

    const close = (type: string) => {
      const trigger = document.querySelector<HTMLElement>(`[data-mega-trigger="${type}"]`);
      const btn = trigger?.querySelector<HTMLButtonElement>('[data-mobile-expand]');
      const menu = document.querySelector<HTMLElement>(`[data-mega-menu="${type}"]`);
      if (!menu || !btn || !trigger) return;
      trigger.removeAttribute('data-mega-open');
      menu.removeAttribute('data-mega-open');
      btn.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    };

    triggers.forEach((trigger) => {
      const type = trigger.getAttribute('data-mega-trigger');
      if (!type) return;
      const menu = document.querySelector<HTMLElement>(`[data-mega-menu="${type}"]`);
      if (!menu) return;

      trigger.addEventListener('mouseenter', () => {
        window.clearTimeout(closeTimer);
        window.clearTimeout(openTimer);
        openTimer = window.setTimeout(() => open(type), 100);
      });
      trigger.addEventListener('mouseleave', () => {
        window.clearTimeout(openTimer);
        closeTimer = window.setTimeout(() => close(type), 200);
      });
      menu.addEventListener('mouseenter', () => {
        window.clearTimeout(closeTimer);
      });
      menu.addEventListener('mouseleave', () => {
        closeTimer = window.setTimeout(() => close(type), 200);
      });
      const link = trigger.querySelector<HTMLAnchorElement>('.main-nav__link');
      link?.addEventListener('focus', () => open(type));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!header?.contains(target)) closeAll();
    });
  }
</script>
</script>
