---
interface Props {
  title: string;
  items: Array<{ q: string; a: string }>;
}
const { title, items } = Astro.props;
---
<section class="faq section section--alt" aria-labelledby="faq-title">
  <div class="container">
    <header class="faq__header">
      <h2 id="faq-title">{title}</h2>
    </header>
    <ul class="faq__list" data-faq-accordion>
      {items.map((item) => (
        <li class="faq__item">
          <details>
            <summary>
              <span>{item.q}</span>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div class="faq__answer">
              <div class="faq__answer-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Acordeón: al abrir un <details> se cierran los demás del mismo bloque FAQ.
  // Scope: cada <ul data-faq-accordion> es independiente (cada FAQ en la página).
  document.querySelectorAll<HTMLUListElement>('ul[data-faq-accordion]').forEach((list) => {
    const items = list.querySelectorAll<HTMLDetailsElement>('details');
    items.forEach((d) => {
      d.addEventListener('toggle', () => {
        if (!d.open) return;
        items.forEach((other) => {
          if (other !== d && other.open) other.open = false;
        });
      });
    });
  });
</script>

<style>
  .faq__header { text-align: center; margin-bottom: var(--s-10); }
  .faq__list { list-style: none; max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--s-3); }
  .faq__item {
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq__item:hover { border-color: var(--c-navy-800); }

  .faq__item details summary {
    list-style: none;
    cursor: pointer;
    padding: var(--s-4) var(--s-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    font-weight: 600;
    color: var(--c-ink);
    font-size: 1rem;
    transition: color 0.2s ease;
  }
  .faq__item details summary::-webkit-details-marker { display: none; }
  .faq__item details summary::marker { display: none; content: ''; }
  .faq__item details[open] > summary { color: var(--c-coral-700); }
  .faq__item details summary .icon {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }
  .faq__item details[open] summary .icon { transform: rotate(180deg); }

  /* Animación suave de apertura/cierre con grid-template-rows (0fr -> 1fr).
     Truco CSS estándar: el contenedor de la respuesta colapsa a 0 filas cuando
     está cerrado y a 1 fila cuando está abierto, animando la altura. */
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq__item details[open] .faq__answer {
    grid-template-rows: 1fr;
  }
  .faq__answer-inner {
    overflow: hidden;
    min-height: 0;
  }
  .faq__answer-inner > p {
    margin: 0;
    padding: 0 var(--s-5) var(--s-5);
    color: var(--c-muted);
    line-height: 1.65;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.24s ease 0.04s, transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) 0.04s;
  }
  .faq__item details[open] .faq__answer-inner > p {
    opacity: 1;
    transform: translateY(0);
  }
</style>
