---
/**
 * ProductCard — tarjeta de producto con BorderGlow.
 *
 * Variantes:
 *  - accent="coral" (default): fondo blanco, badge en coral. Producto normal.
 *  - accent="navy": fondo navy oscuro, badge en coral. Producto destacado.
 *
 * Badges:
 *  - status: 'alpha' | 'beta' | 'estable' → badge pequeño siempre visible.
 *  - featured: boolean → si true, badge "★ DESTACADO" REEMPLAZA al de status
 *    (más prominente, mayor jerarquía visual).
 *
 * Precios:
 *  - priceFrom: precio del tier más barato (tier 0 = free en Simplifica/Strata).
 *    El padre lo calcula con getStartingPrice() desde products.ts.
 *  - priceUnit: "/mes" por defecto.
 */
import { t } from '~/i18n/ui';
import { getLocaleFromUrl, localizePath } from '~/lib/i18n';
import BorderGlow from '~/components/BorderGlow.astro';

type ProductStatus = 'alpha' | 'beta' | 'estable';

interface Props {
  slug: string;
  name: string;
  tagline: string;
  description: string;
  status: ProductStatus;
  priceFrom: number;
  priceUnit: string;
  icon: string;
  /** Si true, el producto es el destacado del index (badge "DESTACADO" reemplaza al de status). */
  featured?: boolean;
  accent?: 'coral' | 'navy';
  /** Logo real del producto (sustituye al SVG icon). Usado por Simplifica. */
  logo?: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}

const {
  slug, name, tagline, description,
  status, priceFrom, priceUnit, icon, logo,
  featured = false, accent = 'coral',
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

// Background del card según accent — el mesh gradient se ajusta a contraste.
const cardBg = accent === 'coral' ? '#ffffff' : '#0E2347';
const glowHsl = accent === 'coral' ? '14 80 60' : '215 70 55';
const meshColors = accent === 'coral'
  ? ['#1B3A6B', '#FF7A4D', '#FFE0D2']   // navy + coral + coral-light (sobre fondo claro)
  : ['#FF7A4D', '#5FE39A', '#284F8E'];  // coral + verde pulse + navy-700 (sobre fondo oscuro)

const statusLabel = status === 'alpha' ? 'ALPHA' : status === 'beta' ? 'BETA' : 'ESTABLE';
// Si featured, mostramos "DESTACADO" en lugar del badge de status (mayor prominencia).
const primaryBadge = featured ? '★ DESTACADO' : statusLabel;
const secondaryBadge = featured ? statusLabel : null; // sub-badge con el status real
---
<BorderGlow
  href={localizePath(`/productos/${slug}`, locale)}
  className={`product-card product-card--${accent}${featured ? ' product-card--featured' : ''}`}
  backgroundColor={cardBg}
  borderRadius={16}
  glowColor={glowHsl}
  glowRadius={18}
  fillOpacity={accent === 'coral' ? 0.18 : 0.28}
  colors={meshColors}
>
  <div class="border-glow-inner product-card__inner">
    <div class="product-card__header">
      {logo ? (
        <span class="icon-box icon-box--logo" aria-hidden={logo.alt ? undefined : 'true'}>
          <picture>
            <source srcset={`${logo.src}.webp`} type="image/webp" />
            <img
              src={`${logo.src}.png`}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </span>
      ) : (
        <span class="icon-box" aria-hidden="true">
          <svg class="icon icon--lg" viewBox="0 0 24 24" aria-hidden="true">
            {icon === 'users-round' && <><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/></>}
            {icon === 'layers' && <><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></>}
          </svg>
        </span>
      )}
      <div class="product-card__badges">
        <span class={`product-card__badge product-card__badge--primary`}>{primaryBadge}</span>
        {secondaryBadge && <span class="product-card__badge product-card__badge--secondary">{secondaryBadge}</span>}
      </div>
    </div>
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__tagline">{tagline}</p>
    <p class="product-card__desc">{description}</p>
    <div class="product-card__footer">
      <span class="product-card__price">
        <span class="product-card__price-from">{t(locale, 'common.from')}</span>
        <span class="product-card__price-amount">{priceFrom}€</span>
        <span class="product-card__price-unit">{priceUnit}</span>
      </span>
      <span class="product-card__cta">
        {t(locale, 'cta.discover')}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14m-7-7 7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</BorderGlow>

<style>
  /* El <a> exterior lleva .product-card + .border-glow-card y tiene su propio
     scope; el .border-glow-inner viene de BorderGlow.astro (otro scope).
     Usamos :global() para que las reglas de layout atraviesen ambos scopes. */
  :global(.product-card .border-glow-inner) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    color: var(--c-text);
    height: 100%;
  }

  /* === Header === */
  :global(.product-card__header) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-3);
  }
  /* Cuando el icono-box contiene un <img> del logo, lo dimensionamos como icono */
  :global(.icon-box--logo) {
    padding: 0;
    background: transparent;
    border: 0;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  :global(.icon-box--logo img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  :global(.product-card__badges) {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
  }

  /* === Badges === */
  :global(.product-card__badge) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-sm);
    line-height: 1.4;
    white-space: nowrap;
  }
  /* Badge principal (status o DESTACADO si featured) */
  :global(.product-card__badge--primary) {
    background: var(--c-coral-500);
    color: #fff;
  }
  /* Sub-badge con el status real cuando featured=true */
  :global(.product-card__badge--secondary) {
    background: transparent;
    color: var(--c-muted);
    border: 1px solid var(--c-line);
    font-size: 0.625rem;
    padding: 0.15rem 0.5rem;
  }
  /* En variante navy, el sub-badge usa borde blanco/20 */
  :global(.product-card--navy .product-card__badge--secondary) {
    color: rgba(255, 255, 255, 0.55);
    border-color: rgba(255, 255, 255, 0.18);
  }

  /* === Tipografía y colores base (variante coral / fondo claro) === */
  :global(.product-card__name) {
    color: var(--c-ink);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }
  :global(.product-card__tagline) {
    color: var(--c-navy-800);
    font-size: 0.9375rem;
    font-weight: 500;
    margin: 0;
  }
  :global(.product-card__desc) {
    color: var(--c-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }
  :global(.product-card__footer) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
    margin-top: var(--s-3);
  }
  :global(.product-card__price) {
    display: inline-flex;
    flex-direction: column;
  }
  :global(.product-card__price-from) {
    font-size: 0.6875rem;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  :global(.product-card__price-amount) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  :global(.product-card__price-unit) {
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  :global(.product-card__cta) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-navy-800);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  :global(.product-card__cta .icon) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s;
  }
  :global(.product-card:hover .product-card__cta .icon) {
    transform: translateX(4px);
  }

  /* === Variante navy (producto destacado) === */
  /* Subimos la opacidad del body text: 0.85 era justo en el límite WCAG. */
  :global(.product-card--navy .border-glow-inner) {
    color: rgba(255, 255, 255, 0.95);
  }
  :global(.product-card--navy .product-card__name) {
    color: #fff;
  }
  :global(.product-card--navy .product-card__tagline) {
    color: var(--c-coral-500);
  }
  :global(.product-card--navy .product-card__desc) {
    color: rgba(255, 255, 255, 0.78);
  }
  :global(.product-card--navy .product-card__footer) {
    border-top-color: rgba(255, 255, 255, 0.12);
  }
  /* Labels de precio en navy: subido de 0.55 → 0.7 para mejor contraste. */
  :global(.product-card--navy .product-card__price-from) {
    color: rgba(255, 255, 255, 0.7);
  }
  :global(.product-card--navy .product-card__price-amount) {
    color: #fff;
  }
  :global(.product-card--navy .product-card__price-unit) {
    color: rgba(255, 255, 255, 0.7);
  }
  :global(.product-card--navy .product-card__cta) {
    color: var(--c-coral-500);
  }

  /* Cuando es featured, opcionalmente un borde más visible */
  :global(.product-card--featured) {
    --glow-card-border-color: rgba(255, 122, 77, 0.3);
  }
</style>
