---
/**
 * PricingTable — renderiza los tiers de un producto o servicio en grid responsive.
 *
 * Diseñado para soportar tanto:
 *  - Productos SaaS (Simplifica, Strata) con precio /mes.
 *  - Servicios de mantenimiento/suscripcion (WordPress) con 4 tiers /mes.
 *  - Servicios de proyecto (Desarrollo WP, Apps) con 1 tier /proyecto.
 *
 * El tier con `highlight: true` se eleva y se marca con badge "RECOMENDADO".
 * Cada tier puede tener un `target` ("Ideal para X") que se muestra bajo el nombre.
 *
 * Uso:
 *   <PricingTable source={products.find(p => p.slug === 'simplifica')!} />
 *   <PricingTable source={services.find(s => s.slug === 'mantenimiento-wordpress')!} />
 */
import type { Locale } from '~/i18n/locales';
import type { Tier } from '~/data/products';
import Button from '~/components/Button.astro';
import { getLocaleFromUrl, localizePath } from '~/lib/i18n';

type PriceUnit = 'mes' | 'proyecto';

export interface PricingSource {
  slug: string;
  name: string;
  shortDescription: Record<Locale, string>;
  tiers: Array<Tier & { target?: string }>;
  cta?: { label: string; href: string };
  priceUnit?: PriceUnit;
}

interface Props {
  source: PricingSource;
}
const { source } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

// Textos comunes por idioma
const i18n = {
  es: {
    recommended: 'RECOMENDADO',
    idealFor: 'Ideal para',
    perMonth: '/mes',
    perProject: '/proyecto',
    cta: {
      free: 'Apuntarme a la lista de espera',
      paid: 'Más información',
      contact: 'Contactar',
    },
    setupTitle: 'Sobre el setup',
  },
  ca: {
    recommended: 'RECOMENDAT',
    idealFor: 'Ideal per',
    perMonth: '/mes',
    perProject: '/projecte',
    cta: {
      free: 'Apuntar-me a la llista d\'espera',
      paid: 'Més informació',
      contact: 'Contactar',
    },
    setupTitle: 'Sobre el setup',
  },
  en: {
    recommended: 'RECOMMENDED',
    idealFor: 'Best for',
    perMonth: '/month',
    perProject: '/project',
    cta: {
      free: 'Join the waitlist',
      paid: 'More information',
      contact: 'Get in touch',
    },
    setupTitle: 'About setup',
  },
}[locale];

const unitLabel = source.priceUnit === 'proyecto' ? i18n.perProject : i18n.perMonth;

// Resuelve la etiqueta del CTA segun si el tier es Free (0€) o de pago, y el source.
function resolveCtaLabel(tierPrice: number, isHighlight: boolean): string {
  if (tierPrice === 0) return i18n.cta.free;
  return i18n.cta.paid;
}

// Resuelve el href del CTA: para productos va a /contacto/{slug}?tier=...
// Para servicios va a /contacto?service={slug}&tier=...
function resolveCtaHref(source: PricingSource, tierId: string, tierPrice: number): string {
  // Detectar si es producto (tiene slug que matchea products) o servicio.
  // Simplificacion: si el slug es 'simplifica' o 'strata' es producto. Si no, servicio.
  const isProduct = source.slug === 'simplifica' || source.slug === 'strata';
  if (isProduct) {
    const intent = tierPrice === 0 ? 'waitlist' : 'info';
    const params = new URLSearchParams();
    if (tierPrice !== 0) params.set('tier', tierId);
    params.set('intent', intent);
    return `/contacto/${source.slug}?${params.toString()}`;
  }
  // Servicio: CTA apunta al /contacto generico con prefill
  const params = new URLSearchParams();
  params.set('service', source.slug);
  if (tierId) params.set('tier', tierId);
  return `/contacto?${params.toString()}`;
}

// Máximo 3 columnas siempre. Simplifica (4) = 3+1, Strata (5) = 3+2, Mantenimiento (4) = 3+1, single = 1.
---
<section class="pricing-table-section" aria-labelledby="pricing-table-heading">
  <div class="container">
    <h2 id="pricing-table-heading" class="pricing-table__title">{source.name}</h2>
    <p class="pricing-table__subtitle">{source.shortDescription[locale]}</p>

    <div class="pricing-grid">
      {source.tiers.map((tier) => {
        const isHighlight = !!tier.highlight;
        const ctaLabel = resolveCtaLabel(tier.price, isHighlight);
        const ctaHref = resolveCtaHref(source, tier.id, tier.price);
        // El tier Free (0€) muestra "Gratis" o "Free" o 0€ según locale.
        const priceDisplay = tier.price === 0
          ? (locale === 'en' ? 'Free' : locale === 'ca' ? 'Gratis' : 'Gratis')
          : `${tier.price}€`;

        return (
          <article
            class:list={[
              'tier-card',
              isHighlight && 'tier-card--highlight',
            ]}
            data-tier={tier.id}
            aria-label={`${tier.name} — ${priceDisplay}${tier.price > 0 ? ' ' + unitLabel : ''}`}
          >
            {isHighlight && <span class="tier-card__ribbon">{i18n.recommended}</span>}
            <header class="tier-card__header">
              <h3 class="tier-card__name">{tier.name}</h3>
              {tier.target && <p class="tier-card__target">{i18n.idealFor}: {tier.target}</p>}
              <div class="tier-card__price">
                <span class="tier-card__price-amount">{priceDisplay}</span>
                {tier.price > 0 && <span class="tier-card__price-unit">{unitLabel}</span>}
              </div>
            </header>

            <ul class="tier-card__features">
              {tier.features.map((f) => (
                <li class="tier-card__feature">
                  <svg viewBox="0 0 24 24" class="tier-card__feature-icon" aria-hidden="true">
                    <path d="M5 12l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <div class="tier-card__cta">
              <Button
                href={localizePath(ctaHref, locale)}
                variant={isHighlight ? 'primary' : 'secondary'}
                size="md"
                external={false}
              >
                {ctaLabel}
              </Button>
            </div>
          </article>
        );
      })}
    </div>

    {source.cta?.href === '/contacto' && null}
  </div>
</section>

<style>
  .pricing-table-section { padding-block: var(--s-12); }
  .pricing-table__title { text-align: center; margin-bottom: var(--s-3); }
  .pricing-table__subtitle {
    text-align: center;
    color: var(--c-muted);
    max-width: 640px;
    margin: 0 auto var(--s-10);
    font-size: 1.0625rem;
  }

  /* === Grid de tiers === */
  /* Max 3 columnas: Simplifica (4 tiers) = 3+1, Strata (5 tiers) = 3+2. */
  .pricing-grid {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: 1fr;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .pricing-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* === Tier card === */
  .tier-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    padding: var(--s-6);
  }

  .tier-card--highlight {
    background: var(--c-navy-900);
    border-color: var(--c-coral-500);
    border-width: 2px;
    color: #fff;
    transform: scale(1.03);
    box-shadow: 0 12px 32px -12px rgba(27, 58, 107, 0.25);
  }

  .tier-card__ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--c-coral-500);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.8rem;
    border-radius: var(--r-sm);
    white-space: nowrap;
  }

  .tier-card__header {
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-line);
    margin-bottom: var(--s-4);
  }
  .tier-card--highlight .tier-card__header {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }
  .tier-card__name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--c-ink);
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }
  .tier-card--highlight .tier-card__name { color: #fff; }
  .tier-card__target {
    font-size: 0.8125rem;
    color: var(--c-muted);
    margin: 0 0 var(--s-3);
    line-height: 1.35;
  }
  .tier-card--highlight .tier-card__target { color: rgba(255, 255, 255, 0.7); }

  .tier-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }
  .tier-card__price-amount {
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .tier-card--highlight .tier-card__price-amount { color: #fff; }
  .tier-card__price-unit {
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .tier-card--highlight .tier-card__price-unit { color: rgba(255, 255, 255, 0.65); }

  /* === Features === */
  .tier-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .tier-card__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--c-text);
  }
  .tier-card--highlight .tier-card__feature { color: rgba(255, 255, 255, 0.9); }
  .tier-card__feature-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--c-coral-500);
    flex-shrink: 0;
    margin-top: 0.18rem;
  }
  .tier-card--highlight .tier-card__feature-icon { color: var(--c-coral-500); }

  /* === CTA === */
  .tier-card__cta {
    margin-top: auto;
  }
  .tier-card__cta :global(.btn) {
    width: 100%;
    justify-content: center;
  }
</style>
