---
// Reviews de Google Places — fetch client-side para superar la limitación
// de "API keys with referer restrictions cannot be used with this API" en
// Google Places API server-side. El navegador del usuario envía el header
// Referer: https://sincronia.agency/... automáticamente, que matchea con
// cualquier whitelist de dominio configurada en Google Cloud Console.
//
// Env vars requeridas (deben empezar con PUBLIC_ para que Astro las exponga
// al cliente en el bundle):
//   PUBLIC_GOOGLE_PLACES_KEY  — API key con restriction por HTTP referrer
//   PUBLIC_GOOGLE_PLACE_ID    — ChIJ... del negocio en Google Maps
//
// Coste: cada visita única del usuario hace 1 fetch a Google. Con cache de
// 1h en navegador, en la práctica son <5 fetches/mes/usuario.
const KEY = import.meta.env.PUBLIC_GOOGLE_PLACES_KEY as string | undefined;
const PLACE = import.meta.env.PUBLIC_GOOGLE_PLACE_ID as string | undefined;
const LANG = 'es';

// Si faltan env vars, renderizamos un fallback estático (no rompe el sitio).
const hasConfig = Boolean(KEY && PLACE);
---

<section
  class="section reviews"
  aria-label="Reseñas de clientes"
  id="google-reviews"
  data-key={KEY ?? ''}
  data-place={PLACE ?? ''}
  data-lang={LANG}
  data-configured={hasConfig ? 'true' : 'false'}
>
  <div class="container">
    <div id="google-reviews-content" aria-live="polite">
      <noscript>
        <p class="reviews__fallback">Activa JavaScript para ver las reseñas de Google.</p>
      </noscript>
      <div class="reviews__skeleton" data-skeleton>
        <header class="reviews__header">
          <span class="eyebrow">Reseñas verificadas</span>
          <h2>Lo que dicen nuestros clientes</h2>
        </header>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" id="reviews-schema">
{ "@context": "https://schema.org", "@type": "LocalBusiness", "name": "Sincronia Agency" }
</script>

<script>
  // Fetch client-side + render + cache localStorage 1h
  (() => {
    const root = document.getElementById('google-reviews');
    if (!root) return;
    const KEY = root.dataset.key;
    const PLACE = root.dataset.place;
    const LANG = root.dataset.lang || 'es';
    const content = document.getElementById('google-reviews-content');
    const schemaEl = document.getElementById('reviews-schema');
    if (!content) return;

    if (!KEY || !PLACE || root.dataset.configured !== 'true') {
      content.innerHTML = '<p class="reviews__fallback">Aún no hay reseñas configuradas.</p>';
      return;
    }

    const CACHE_KEY = 'sincronia-reviews';
    const CACHE_TTL = 60 * 60 * 1000; // 1 hora

    const cached = (() => {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const { ts, data } = JSON.parse(raw);
        if (Date.now() - ts > CACHE_TTL) return null;
        return data;
      } catch { return null; }
    })();

    const render = (data: any) => {
      if (!data?.result || data.status !== 'OK') {
        content.innerHTML = '<p class="reviews__fallback">No hemos podido cargar las reseñas. <a href="https://maps.app.goo.gl/qDuyVJGvNpvBT2u99" target="_blank" rel="noopener">Ver en Google Maps</a>.</p>';
        return;
      }
      const place = data.result;
      const reviews = place.reviews ?? [];
      const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
      const round = Math.round(place.rating);

      // Schema JSON-LD con aggregateRating
      const schema = {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: place.name,
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: place.rating,
          reviewCount: place.user_ratings_total,
        },
        address: place.formatted_address,
      };
      if (schemaEl) schemaEl.textContent = JSON.stringify(schema);

      const reviewsHTML = reviews.map((r: any) => {
        const t = new Date(r.time * 1000);
        const tISO = t.toISOString();
        return `
          <li class="review">
            <div class="review__head">
              <div class="review__avatar" aria-hidden="true">${(r.author_name || '?').charAt(0).toUpperCase()}</div>
              <div>
                <p class="review__author">${r.author_name}</p>
                <p class="review__meta">
                  <span class="review__stars" aria-label="${r.rating} de 5 estrellas">${stars(r.rating)}</span>
                  <time datetime="${tISO}">${r.relative_time_description}</time>
                </p>
              </div>
            </div>
            <p class="review__text">${r.text}</p>
          </li>
        `;
      }).join('');

      content.innerHTML = `
        <header class="reviews__header">
          <span class="eyebrow">Reseñas verificadas</span>
          <h2>Lo que dicen nuestros clientes</h2>
          <p class="reviews__rating">
            <strong>${place.rating.toFixed(1)}</strong>
            <span class="reviews__stars" aria-hidden="true">${stars(round)}</span>
            <span class="reviews__count">de ${place.user_ratings_total} reseñas en Google</span>
          </p>
        </header>
        <ul class="reviews__list">${reviewsHTML}</ul>
        <a class="reviews__cta" href="${place.url}" target="_blank" rel="noopener">
          Ver todas las reseñas en Google →
        </a>
        <p class="reviews__attribution">
          Reseñas proporcionadas por Google. <a href="${place.url}" target="_blank" rel="noopener">${place.name}</a> en Google Maps.
        </p>
      `;
    };

    if (cached) {
      render(cached);
      return;
    }

    const url = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${encodeURIComponent(PLACE)}&fields=name,rating,user_ratings_total,reviews,formatted_address,url&language=${LANG}&reviews_sort=newest&key=${encodeURIComponent(KEY)}`;
    fetch(url)
      .then((r) => r.json())
      .then((data) => {
        try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data })); } catch {}
        render(data);
      })
      .catch(() => {
        content.innerHTML = '<p class="reviews__fallback">No hemos podido cargar las reseñas. <a href="https://maps.app.goo.gl/qDuyVJGvNpvBT2u99" target="_blank" rel="noopener">Ver en Google Maps</a>.</p>';
      });
  })();
</script>

<style>
  .reviews { background: var(--c-bg-alt, #f8fafc); }
  .reviews__header { text-align: center; max-width: 640px; margin-inline: auto; margin-bottom: var(--s-10); }
  .reviews__header h2 { margin-block: var(--s-3) var(--s-4); }
  .reviews__header .eyebrow { display: inline-block; }
  .reviews__rating { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--c-muted); flex-wrap: wrap; justify-content: center; }
  .reviews__rating strong { font-size: 1.75rem; color: var(--c-ink); }
  .reviews__stars { color: #f59e0b; letter-spacing: 0.05em; }
  .reviews__count { font-size: 0.9375rem; }
  .reviews__list {
    list-style: none; display: grid; gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    padding: 0; margin: 0 0 var(--s-8);
  }
  .review { background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-md); padding: var(--s-5); display: flex; flex-direction: column; gap: var(--s-4); }
  .review__head { display: flex; gap: var(--s-3); align-items: center; }
  .review__avatar { width: 2.5rem; height: 2.5rem; border-radius: var(--r-full); background: var(--c-navy-50, #eef2ff); color: var(--c-navy-900, #1B3A6B); display: grid; place-items: center; font-weight: 700; }
  .review__author { font-weight: 600; font-size: 0.9375rem; }
  .review__meta { display: flex; gap: var(--s-2); align-items: center; font-size: 0.8125rem; color: var(--c-muted); margin-top: 0.125rem; flex-wrap: wrap; }
  .review__stars { color: #f59e0b; }
  .review__text { color: var(--c-ink, #0f172a); line-height: 1.5; font-size: 0.9375rem; }
  .reviews__cta, .reviews__attribution { text-align: center; }
  .reviews__cta { display: inline-block; margin: 0 auto; font-weight: 600; color: var(--c-coral-700, #d83a1a); }
  .reviews__attribution { font-size: 0.75rem; color: var(--c-muted, #64748b); margin-top: var(--s-4); }
  .reviews__fallback { text-align: center; color: var(--c-muted, #64748b); padding: var(--s-8) 0; }
  .reviews__skeleton { min-height: 200px; }
</style>
