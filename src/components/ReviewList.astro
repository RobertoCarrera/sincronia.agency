---
// Reviews de Google Places — diseño Sincronia (1 reseña grande, sin grid).
// El HTML de la card se renderiza en Astro con CSS scoped. El JS solo
// actualiza textContent y src — no inyecta HTML con innerHTML (eso era
// lo que hacía que las estrellas se renderizaran con tamaño default).
// Si no hay key/place_id, se muestra fallback "Reseñas no disponibles".
---

<section class="section section--tint reviews" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews__head">
      <h2 id="reviews-title">Lo que dicen nuestros clientes</h2>
      <p class="reviews__count" data-reviews-count>8 reseñas verificadas de Google</p>
      <div class="reviews__stars" data-reviews-stars role="img" aria-label="5 estrellas sobre 5">
        <span class="reviews__star is-on"></span>
        <span class="reviews__star is-on"></span>
        <span class="reviews__star is-on"></span>
        <span class="reviews__star is-on"></span>
        <span class="reviews__star is-on"></span>
      </div>
    </header>

    <article class="review-card" data-reviews-card>
      <div class="review-card__skeleton" data-reviews-skeleton>
        <div class="review-card__head-skel">
          <div class="sk sk-avatar"></div>
          <div class="review-card__head-lines">
            <div class="sk sk-line sk-line--sm"></div>
            <div class="sk sk-line sk-line--xs"></div>
          </div>
        </div>
        <div class="sk sk-line sk-line--lg"></div>
        <div class="sk sk-line sk-line--md"></div>
        <div class="sk sk-line sk-line--sm"></div>
      </div>
      <div class="review-card__body" data-reviews-body hidden>
        <header class="review-card__head">
          <div class="review-card__avatar" data-reviews-avatar aria-hidden="true">?</div>
          <div>
            <p class="review-card__name" data-reviews-name>—</p>
            <p class="review-card__time" data-reviews-time></p>
          </div>
        </header>
        <blockquote class="review-card__quote">
          <p class="review-card__text" data-reviews-text></p>
        </blockquote>
        <footer class="review-card__foot">
          <a class="review-card__profile" data-reviews-profile href="#" target="_blank" rel="noopener">Ver perfil en Google →</a>
        </footer>
      </div>
    </article>

    <div class="reviews__error" data-reviews-error hidden>
      <p>No hemos podido cargar las reseñas ahora mismo.</p>
      <a data-reviews-link href="https://maps.app.goo.gl/qDuyVJGvNpvBT2u99" target="_blank" rel="noopener">Ver en Google →</a>
    </div>

    <div class="reviews__foot">
      <a class="reviews__all" data-reviews-all href="https://search.google.com/local/reviews?placeid=ChIJMwrnMJFY800Rrsn96EJgBGw" target="_blank" rel="noopener">Ver las 8 reseñas en Google →</a>
    </div>
  </div>
</section>

<script is:inline src="/assets/js/config.js"></script>
<script is:inline src="/assets/js/reviews.js?v=2" defer></script>

<style>
  .reviews.section--tint { background: var(--c-bg-alt, #f8fafc); }

  .reviews__head { text-align: center; margin-bottom: var(--s-8); }
  .reviews__head h2 { margin-bottom: var(--s-3); }
  .reviews__count { color: var(--c-muted, #64748b); font-size: 0.9375rem; margin-bottom: var(--s-4); }

  .reviews__stars { display: inline-flex; gap: 0.25rem; }
  .reviews__star {
    display: inline-block;
    width: 18px;
    height: 18px;
    background: #e5e7eb;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M10 1l2.928 6.343 6.572.95-4.75 4.628 1.121 6.534L10 16.85l-5.871 2.65 1.121-6.534L0.5 8.293l6.572-.95z'/></svg>") no-repeat center / contain;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M10 1l2.928 6.343 6.572.95-4.75 4.628 1.121 6.534L10 16.85l-5.871 2.65 1.121-6.534L0.5 8.293l6.572-.95z'/></svg>") no-repeat center / contain;
  }
  .reviews__star.is-on { background: #fbbf24; }

  .review-card {
    max-width: 720px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--c-line, #e2e8f0);
    border-radius: var(--r-md, 20px);
    padding: var(--s-8, 2.5rem);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    position: relative;
  }

  /* Skeleton mientras carga */
  .review-card__skeleton { display: flex; flex-direction: column; gap: var(--s-4, 1rem); }
  .sk { background: linear-gradient(90deg, #eef2f5 0%, #f6f8fa 50%, #eef2f5 100%); background-size: 200% 100%; border-radius: 6px; display: block; }
  .sk-avatar { width: 48px; height: 48px; border-radius: 50%; }
  .sk-line { height: 14px; }
  .sk-line--lg { width: 100%; height: 18px; }
  .sk-line--md { width: 92%; }
  .sk-line--sm { width: 60%; }
  .sk-line--xs { width: 30%; height: 10px; }
  .review-card__head-skel { display: flex; gap: var(--s-3); align-items: center; }
  .review-card__head-lines { flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
  .sk { animation: sk-shimmer 1.4s linear infinite; }
  @keyframes sk-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

  /* Body cuando carga */
  .review-card__head { display: flex; gap: var(--s-4, 1rem); align-items: center; margin-bottom: var(--s-5, 1.25rem); }
  .review-card__avatar {
    width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center;
    background: linear-gradient(135deg, #1B3A6B 0%, #FF7A4D 100%);
    color: #fff; font-weight: 700; font-size: 1.125rem;
    flex-shrink: 0;
    overflow: hidden;
  }
  .review-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .review-card__name { font-weight: 700; font-size: 1rem; color: var(--c-ink, #0f172a); margin: 0; }
  .review-card__time { font-size: 0.8125rem; color: var(--c-muted, #64748b); margin: 0.125rem 0 0; }

  .review-card__quote { margin: 0; }
  .review-card__text {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #1e293b;
    margin: 0;
    quotes: none;
  }
  .review-card__text::before, .review-card__text::after { content: none; }

  .review-card__foot {
    margin-top: var(--s-6, 1.5rem);
    padding-top: var(--s-4, 1rem);
    border-top: 1px solid var(--c-line, #e2e8f0);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .review-card__profile {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-coral-700, #d83a1a);
    text-decoration: none;
  }
  .review-card__profile:hover { text-decoration: underline; }

  .reviews__error { text-align: center; padding: var(--s-8) 0; color: var(--c-muted, #64748b); }
  .reviews__error a { color: var(--c-coral-700, #d83a1a); text-decoration: underline; display: block; margin-top: var(--s-2); }

  .reviews__foot { text-align: center; margin-top: var(--s-6, 1.5rem); }
  .reviews__all {
    display: inline-block;
    font-weight: 600;
    color: var(--c-navy-800, #1B3A6B);
    text-decoration: none;
  }
  .reviews__all:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .review-card { padding: var(--s-6, 1.5rem); }
    .review-card__text { font-size: 1rem; }
  }
</style>
