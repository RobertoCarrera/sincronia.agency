---
// Reviews de Google Places — implementación vanilla (sin build step)
// replica de mueveme.es. La API key vive en public/assets/js/config.js
// (público al cliente, restringida por HTTP referrer en Google Cloud).
// El JS de cliente hace fetch directo a la Places API (New) y renderiza
// con rotación cada 5s. Si la key falta, el JS usa un fallback "no
// configurado" sin pintar datos falsos.
---
<section
  class="section section--tint reviews"
  aria-labelledby="reviews-title"
>
  <div class="container">
    <h2 id="reviews-title">Lo que dicen nuestros clientes</h2>
    <p data-reviews-count class="reviews-count-text">Cargando reseñas verificadas de Google…</p>

    <div class="reviews-layout">
      <aside class="reviews-summary">
        <div class="reviews-summary__score" data-reviews-score>–</div>
        <div class="reviews-summary__stars" data-reviews-stars aria-hidden="true"></div>
        <div class="reviews-summary__src" data-reviews-summary></div>
        <a
          class="btn btn--outline btn--sm reviews-summary__cta"
          data-reviews-link
          href="#"
          target="_blank"
          rel="noopener"
        >Ver todas en Google</a>
      </aside>

      <div class="reviews-grid reviews-grid--loading" data-reviews-grid></div>
    </div>

    <p data-reviews-error hidden class="reviews-error">
      No hemos podido cargar las reseñas ahora mismo.
      <a data-reviews-link href="#" target="_blank" rel="noopener">Ver en Google</a>.
    </p>
  </div>
</section>

<!-- API key + Place ID públicos. La key DEBE estar restringida por HTTP
     referrer en Google Cloud Console (sincronia.agency/*) y SOLO a
     Places API (New). Sin esas restricciones es una factura sorpresa. -->
<script is:inline src="/assets/js/config.js"></script>
<!-- defer para que no bloquee el render. ?v=N para cache-busting cuando
     cambiemos el JS (inmutable con cache 1 año en Cloudflare Cache Rules). -->
<script is:inline src="/assets/js/reviews.js?v=1" defer></script>

<style>
  .reviews.section--tint { background: var(--c-bg-alt, #f8fafc); }
  .reviews h2 { text-align: center; margin-bottom: var(--s-2); }
  .reviews-count-text { text-align: center; color: var(--c-muted, #64748b); margin-bottom: var(--s-10); font-size: 0.9375rem; }

  .reviews-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .reviews-layout { grid-template-columns: 280px 1fr; gap: var(--s-10); align-items: start; }
  }

  .reviews-summary {
    background: #fff;
    border: 1px solid var(--c-line, #e2e8f0);
    border-radius: var(--r-md, 16px);
    padding: var(--s-6, 1.5rem);
    text-align: center;
    position: sticky;
    top: var(--s-6);
  }
  .reviews-summary__score { font-size: 2.75rem; font-weight: 800; color: var(--c-ink, #0f172a); line-height: 1; margin-bottom: var(--s-2); }
  .reviews-summary__stars { display: flex; justify-content: center; gap: 0.125rem; color: #fbbf24; margin-bottom: var(--s-3); }
  .reviews-summary__stars svg { width: 18px; height: 18px; }
  .reviews-summary__src { font-size: 0.875rem; color: var(--c-muted, #64748b); margin-bottom: var(--s-4); }
  .reviews-summary__cta { width: 100%; }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4, 1rem);
    transition: opacity 0.35s ease;
  }
  @media (min-width: 700px) { .reviews-grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-5, 1.25rem); } }
  .reviews-grid--loading { min-height: 200px; }
  .reviews-grid--fading { opacity: 0; }
  .reviews-grid--empty { display: none; }

  .review {
    padding: var(--s-5, 1.25rem);
    background: #fff;
    border: 1px solid var(--c-line, #e2e8f0);
    border-radius: var(--r-md, 16px);
    display: flex;
    flex-direction: column;
    gap: var(--s-3, 0.75rem);
  }
  .review__head { display: flex; gap: var(--s-3, 0.75rem); align-items: center; }
  .review__avatar { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #1B3A6B 0%, #FF7A4D 100%); color: #fff; font-weight: 700; flex-shrink: 0; }
  .review__photo { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .review__name { font-weight: 700; font-size: 0.9375rem; color: var(--c-ink, #0f172a); }
  .review__stars { display: flex; gap: 0.0625rem; color: #fbbf24; }
  .review__stars svg { width: 14px; height: 14px; }
  .review__text { color: #334155; line-height: 1.7; font-size: 0.9375rem; }
  .review__src { font-size: 0.8rem; color: var(--c-muted, #64748b); border-top: 1px solid var(--c-line, #e2e8f0); padding-top: var(--s-3, 0.75rem); margin-top: auto; }
  .review__src a { color: inherit; text-decoration: underline; }

  .review--skeleton { gap: var(--s-3); }
  .review--skeleton .sk { background: linear-gradient(90deg, #eef2f5 0%, #f6f8fa 50%, #eef2f5 100%); background-size: 200% 100%; border-radius: 6px; display: block; }
  .review--skeleton .review__avatar.sk { width: 44px; height: 44px; border-radius: 50%; }
  .sk-line { height: 12px; }
  .sk-line--xs { width: 80px; }
  .sk-line--sm { width: 60%; }
  .sk-line--md { width: 90%; }
  .sk-line--lg { width: 100%; height: 14px; }
  @keyframes sk-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

  .reviews-error { text-align: center; color: var(--c-muted, #64748b); padding: var(--s-6) 0; }
  .reviews-error a { color: var(--c-coral-700, #d83a1a); text-decoration: underline; }
</style>
