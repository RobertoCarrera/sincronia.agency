---
import type { Locale } from '~/i18n/locales';
import { services, getStartingServicePrice } from '~/data/services';
import { products, getStartingPrice } from '~/data/products';
import { getServiceIcon, getProductIcon } from '~/lib/icons';
import { localizePath } from '~/lib/i18n';
import { t } from '~/i18n/ui';

interface Props {
  type: 'services' | 'products';
  locale: Locale;
}
const { type, locale } = Astro.props;

const titles: Record<typeof type, Record<Locale, string>> = {
  services: { es: 'Servicios', ca: 'Serveis', en: 'Services' },
  products: { es: 'Productos', ca: 'Productes', en: 'Products' },
};
const subtitles: Record<typeof type, Record<Locale, string>> = {
  services: {
    es: 'Cinco áreas técnicas que cubrimos con la misma profundidad. SEO on-page desde el primer commit.',
    ca: 'Cinc àrees tècniques que cobrim amb la mateixa profunditat. SEO on-page des del primer commit.',
    en: 'Five technical areas we cover with the same depth. On-page SEO from the first commit.',
  },
  products: {
    es: 'Un CRM en beta con clientes, un CMS en alpha al que puedes apuntarte a la lista de espera.',
    ca: 'Un CRM en beta amb clients, un CMS en alpha on pots apuntar-te a la llista d\'espera.',
    en: 'A CRM in beta with clients, a CMS in alpha you can join the waitlist for.',
  },
};
const ctaTitle: Record<typeof type, Record<Locale, string>> = {
  services: { es: '¿No sabes qué necesitas?', ca: 'No saps què necessites?', en: 'Not sure what you need?' },
  products: { es: 'Acceso anticipado', ca: 'Accés anticipat', en: 'Early access' },
};
const ctaEyebrow: Record<typeof type, Record<Locale, string>> = {
  services: { es: 'Empezar', ca: 'Comença', en: 'Get started' },
  products: { es: 'Lista de espera', ca: 'Llista d\'espera', en: 'Waitlist' },
};
const ctaBody: Record<typeof type, Record<Locale, string>> = {
  services: {
    es: 'Cuéntanos tu proyecto y te recomendamos la combinación ideal. Sin compromiso, respuesta en menos de 24h.',
    ca: 'Explica\'ns el teu projecte i et recomanem la combinació ideal. Sense compromís, resposta en menys de 24h.',
    en: 'Tell us about your project and we will recommend the ideal combination. No commitment, reply in under 24h.',
  },
  products: {
    es: 'Solicita acceso anticipado por WhatsApp. Te preparamos un sandbox con tu caso y te enseñamos cómo encaja.',
    ca: 'Sol·licita accés anticipat per WhatsApp. Et preparem un sandbox amb el teu cas i t\'ensenyem com encaixa.',
    en: 'Request early access via WhatsApp. We set up a sandbox with your case and show you how it fits.',
  },
};
const footerLabel: Record<typeof type, Record<Locale, string>> = {
  services: { es: 'Ver todos los servicios', ca: 'Veure tots els serveis', en: 'View all services' },
  products: { es: 'Ver todos los productos', ca: 'Veure tots els productes', en: 'View all products' },
};

// Etiqueta corta del status para el badge (ALPHA / BETA / ESTABLE).
const statusLabel: Record<'alpha' | 'beta' | 'estable', string> = {
  alpha: 'ALPHA',
  beta: 'BETA',
  estable: 'ESTABLE',
};
---
<div class:list={['mega-menu', `mega-menu--${type}`]} data-mega-menu={type} role="menu" aria-label={titles[type][locale]} hidden>
  <div class="mega-menu__inner">
    <div class="container mega-menu__container">
      <div class="mega-menu__grid">
        <div class="mega-menu__main">
          <header class="mega-menu__header">
            <span class="mega-menu__eyebrow">{titles[type][locale]}</span>
            <p class="mega-menu__subtitle">{subtitles[type][locale]}</p>
          </header>

          {type === 'services' ? (
            <ul class="mega-menu__list mega-menu__list--services">
              {services.map((s, i) => {
                const startPrice = getStartingServicePrice(s);
                const unit = s.priceUnit === 'proyecto' ? '/proyecto' : '/mes';
                return (
                <li class="mega-menu__item" style={`--i:${i}`}>
                  <a href={localizePath(`/servicios/${s.slug}`, locale)} class="mega-menu__link" role="menuitem">
                    <span class="mega-menu__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="icon" set:html={getServiceIcon(s.icon)} />
                    </span>
                    <span class="mega-menu__item-body">
                      <span class="mega-menu__item-title">{s.title}</span>
                      <span class="mega-menu__item-desc">{s.shortDescription[locale]}</span>
                    </span>
                    <span class="mega-menu__item-price">
                      <span class="mega-menu__item-price-amount">{startPrice}€</span>
                      <span class="mega-menu__item-unit">{unit}</span>
                    </span>
                    <span class="mega-menu__arrow" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="icon"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
                    </span>
                  </a>
                </li>
                );
              })}
            </ul>
          ) : (
            <ul class="mega-menu__list mega-menu__list--products">
              {products.map((p, i) => {
                const startPrice = getStartingPrice(p);
                return (
                <li class="mega-menu__item" style={`--i:${i}`}>
                  <a href={localizePath(`/productos/${p.slug}`, locale)} class="mega-menu__link" role="menuitem">
                    {p.logoLockup ? (
                      <span class="mega-menu__icon mega-menu__icon--lockup" aria-hidden="true">
                        <picture>
                          <source srcset={`${p.logoLockup.src}.webp`} type="image/webp" />
                          <img
                            src={`${p.logoLockup.src}.png`}
                            alt=""
                            width={p.logoLockup.width}
                            height={p.logoLockup.height}
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                      </span>
                    ) : p.logo ? (
                      <span class="mega-menu__icon mega-menu__icon--lg mega-menu__icon--logo" aria-hidden="true">
                        <picture>
                          <source srcset={`${p.logo.src}.webp`} type="image/webp" />
                          <img
                            src={`${p.logo.src}.png`}
                            alt=""
                            width={p.logo.width}
                            height={p.logo.height}
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                      </span>
                    ) : (
                      <span class="mega-menu__icon mega-menu__icon--lg" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="icon icon--lg" set:html={getProductIcon(p.icon)} />
                      </span>
                    )}
                    <span class="mega-menu__item-body">
                      <span class="mega-menu__item-title">
                        {p.name}
                        {p.status !== 'estable' && (
                          <span class:list={['mega-menu__badge', `mega-menu__badge--${p.status}`]}>
                            {statusLabel[p.status]}
                          </span>
                        )}
                      </span>
                      <span class="mega-menu__item-desc">{p.shortDescription[locale]}</span>
                    </span>
                    <span class="mega-menu__item-price">
                      <span class="mega-menu__item-price-amount">{startPrice}€</span>
                      <span class="mega-menu__item-unit">/mes</span>
                    </span>
                    <span class="mega-menu__arrow" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="icon"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
                    </span>
                  </a>
                </li>
                );
              })}
            </ul>
          )}

          <footer class="mega-menu__footer">
            <a href={localizePath(type === 'services' ? '/servicios' : '/productos', locale)} class="mega-menu__view-all">
              {footerLabel[type][locale]}
              <svg viewBox="0 0 24 24" class="icon"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
            </a>
          </footer>
        </div>

        <aside class="mega-menu__aside">
          <div class="mega-menu__cta">
            <span class="mega-menu__cta-eyebrow">{ctaEyebrow[type][locale]}</span>
            <h3 class="mega-menu__cta-title">{ctaTitle[type][locale]}</h3>
            <p class="mega-menu__cta-body">{ctaBody[type][locale]}</p>
            <a href={localizePath('/contacto', locale)} class="btn btn--primary mega-menu__cta-btn">
              {type === 'services' ? t(locale, 'cta.quote') : t(locale, 'cta.demo')}
              <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>

<style>
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 16px 32px -8px rgba(11, 18, 32, 0.08), 0 4px 8px -2px rgba(11, 18, 32, 0.04);
    z-index: 30;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .mega-menu[hidden] { display: block; } /* override default hidden to allow transition */
  .mega-menu[data-mega-open="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-menu__inner {
    background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(248, 250, 252, 1) 100%);
  }
  .mega-menu__container { padding-block: var(--s-10); }
  .mega-menu__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }
  @media (min-width: 1024px) {
    .mega-menu__grid { grid-template-columns: 1.8fr 1fr; gap: var(--s-12); }
  }

  .mega-menu__main { min-width: 0; }
  .mega-menu__header { margin-bottom: var(--s-6); padding-bottom: var(--s-5); border-bottom: 1px dashed var(--c-line); }
  .mega-menu__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-coral-700);
    margin-bottom: var(--s-2);
  }
  .mega-menu__subtitle { color: var(--c-muted); font-size: 0.9375rem; max-width: 60ch; }

  .mega-menu__list { list-style: none; display: flex; flex-direction: column; gap: var(--s-1); }
  .mega-menu__item {
    opacity: 0;
    transform: translateY(4px);
    animation: megaItemIn 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 40ms + 80ms);
  }
  @keyframes megaItemIn { to { opacity: 1; transform: translateY(0); } }

  .mega-menu__link {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-md);
    color: var(--c-text);
    text-decoration: none;
    transition: background 0.15s;
  }
  .mega-menu__link:hover { background: var(--c-navy-50); color: var(--c-text); }
  .mega-menu__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-md);
    background: var(--c-coral-50);
    color: var(--c-coral-700);
    flex-shrink: 0;
  }
  .mega-menu__icon--lg {
    width: 3rem;
    height: 3rem;
    background: var(--c-navy-50);
    color: var(--c-navy-800);
  }
  /* Variante logo: sin fondo ni color, deja que la imagen muestre su marca */
  .mega-menu__icon--logo {
    background: transparent;
    color: inherit;
    padding: 0;
    border: 0;
  }
  .mega-menu__icon--logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  /* Variante lockup horizontal (icono + texto). El WebP/PNG trae su
     aspect-ratio intrínseco; el contenedor es rectangular y deja que la
     imagen se vea a tamaño legible. Se prefiere sobre .mega-menu__icon--logo
     porque el icono 3D de Strata no se lee a 48px. */
  .mega-menu__icon--lockup {
    width: 7rem;
    height: auto;
    background: transparent;
    color: inherit;
    padding: 0;
    border: 0;
    border-radius: 0;
    flex-shrink: 0;
  }
  .mega-menu__icon--lockup img {
    width: 100%;
    height: auto;
    display: block;
  }
  .mega-menu__icon .icon { width: 1.25rem; height: 1.25rem; }
  .mega-menu__icon--lg .icon { width: 1.5rem; height: 1.5rem; }
  .mega-menu__item-body { min-width: 0; }
  .mega-menu__item-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--c-ink);
    font-size: 0.9375rem;
    margin-bottom: 0.15rem;
  }
  .mega-menu__badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    padding: 0.1rem 0.4rem;
    border-radius: var(--r-sm);
  }
  .mega-menu__badge--beta { background: var(--c-coral-500); }
  .mega-menu__badge--alpha { background: var(--c-navy-800); }
  .mega-menu__item-desc {
    color: var(--c-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .mega-menu__item-price {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--c-coral-700);
    font-size: 0.875rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }
  .mega-menu__item-price-amount { font-weight: 700; }
  .mega-menu__item-unit { color: var(--c-muted); font-weight: 400; font-size: 0.75rem; margin-left: 0.1rem; }
  .mega-menu__arrow {
    color: var(--c-muted);
    transition: transform 0.2s, color 0.2s;
    opacity: 0;
  }
  .mega-menu__link:hover .mega-menu__arrow { transform: translateX(4px); color: var(--c-coral-500); opacity: 1; }

  .mega-menu__footer {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px dashed var(--c-line);
  }
  .mega-menu__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-navy-800);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .mega-menu__view-all .icon { width: 1rem; height: 1rem; transition: transform 0.2s; }
  .mega-menu__view-all:hover .icon { transform: translateX(4px); }

  /* Aside / CTA card */
  .mega-menu__aside { min-width: 0; }
  .mega-menu__cta {
    background: var(--c-navy-900);
    color: #fff;
    border-radius: var(--r-lg);
    padding: var(--s-6);
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mega-menu__cta::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -20%;
    width: 60%;
    height: 160%;
    background: radial-gradient(circle, var(--c-coral-500) 0%, transparent 60%);
    opacity: 0.18;
    pointer-events: none;
  }
  .mega-menu__cta-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-coral-500);
    margin-bottom: var(--s-3);
    position: relative;
  }
  .mega-menu__cta-title { color: #fff; font-size: 1.375rem; margin-bottom: var(--s-3); position: relative; }
  .mega-menu__cta-body { color: rgba(255, 255, 255, 0.75); font-size: 0.9375rem; line-height: 1.55; margin-bottom: var(--s-5); position: relative; }
  .mega-menu__cta-btn { position: relative; align-self: flex-start; }
  .mega-menu__cta-btn .icon { width: 1rem; height: 1rem; }
  .mega-menu__cta-btn:hover .icon { transform: translateX(4px); }
</style>
