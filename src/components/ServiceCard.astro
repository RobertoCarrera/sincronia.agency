---
import { services } from '~/data/services';
import { t } from '~/i18n/ui';
import { getLocaleFromUrl, localizePath } from '~/lib/i18n';
import { getServiceIcon } from '~/lib/icons';
import BorderGlow from '~/components/BorderGlow.astro';

interface Props {
  slug: string;
  title: string;
  shortDescription: string;
  icon: string;
}
const { slug, title, shortDescription, icon } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const meta = services.find((s) => s.slug === slug);
const priceLabel = meta
  ? `${t(locale, 'common.from')} ${meta.priceFrom}€${meta.priceUnit === 'mes' ? t(locale, 'common.month') : ''}`
  : '';
---
<BorderGlow
  href={localizePath(`/servicios/${slug}`, locale)}
  className="service-card"
  backgroundColor="#ffffff"
  borderRadius={16}
  glowColor="14 80 60"
  glowRadius={16}
  fillOpacity={0.18}
  colors={['#1B3A6B', '#FF7A4D', '#FFE0D2']}
>
  <span class="icon-box icon-box--coral" aria-hidden="true">
    <svg class="icon icon--lg" viewBox="0 0 24 24" set:html={getServiceIcon(icon)} />
  </span>
  <h3 class="service-card__title">{title}</h3>
  <p class="service-card__desc">{shortDescription}</p>
  {priceLabel && <span class="service-card__price">{priceLabel}</span>}
  <span class="service-card__cta">
    {t(locale, 'cta.learn-more')}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14m-7-7 7 7-7 7"></path>
    </svg>
  </span>
</BorderGlow>
<style>
  /* El <a> exterior lleva .service-card + .border-glow-card y tiene su propio
     scope; el .border-glow-inner viene de BorderGlow.astro (otro scope).
     Usamos :global() para que las reglas de layout atraviesen ambos scopes. */
  :global(.service-card .border-glow-inner) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    color: var(--c-text);
    height: 100%;
  }

  .service-card__title { color: var(--c-ink); font-size: 1.25rem; margin: 0; }
  .service-card__desc { color: var(--c-muted); font-size: 0.9375rem; line-height: 1.6; flex: 1; }
  .service-card__price {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--c-coral-700);
    font-weight: 500;
  }
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-navy-800);
    font-weight: 600;
    font-size: 0.9375rem;
    margin-top: var(--s-2);
  }
  .service-card__cta .icon { width: 1rem; height: 1rem; transition: transform 0.2s; }
  :global(.service-card:hover) .service-card__cta .icon { transform: translateX(4px); }
</style>
