---
import { services } from '~/data/services';
import { t } from '~/i18n/ui';
import { getLocaleFromUrl, localizePath } from '~/lib/i18n';

interface Props {
  slug: string;
  title: string;
  shortDescription: string;
  icon: string;
}
const { slug, title, shortDescription, icon } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const meta = services.find((s) => s.slug === slug);
const priceLabel = meta
  ? `${t(locale, 'common.from')} ${meta.priceFrom}€${meta.priceUnit === 'mes' ? t(locale, 'common.month') : ''}`
  : '';
---
<a href={localizePath(`/servicios/${slug}`, locale)} class="service-card">
  <span class="icon-box icon-box--coral" aria-hidden="true">
    <svg class="icon icon--lg" viewBox="0 0 24 24" aria-hidden="true">
      {icon === 'shield-check' && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4"></path>}
      {icon === 'layout-template' && <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></>}
      {icon === 'code-2' && <><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></>}
      {icon === 'trending-up' && <><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></>}
      {icon === 'server' && <><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></>}
    </svg>
  </span>
  <h3 class="service-card__title">{title}</h3>
  <p class="service-card__desc">{shortDescription}</p>
  {priceLabel && <span class="service-card__price">{priceLabel}</span>}
  <span class="service-card__cta">
    {t(locale, 'cta.learn-more')}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14m-7-7 7 7-7 7"></path>
    </svg>
  </span>
</a>
<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    color: var(--c-text);
    transition: all 0.2s ease;
    height: 100%;
  }
  .service-card:hover {
    border-color: var(--c-navy-800);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: var(--c-text);
  }
  .service-card__title { color: var(--c-ink); font-size: 1.25rem; margin: 0; }
  .service-card__desc { color: var(--c-muted); font-size: 0.9375rem; line-height: 1.6; flex: 1; }
  .service-card__price {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--c-coral-700);
    font-weight: 500;
  }
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-navy-800);
    font-weight: 600;
    font-size: 0.9375rem;
    margin-top: var(--s-2);
  }
  .service-card__cta .icon { width: 1rem; height: 1rem; transition: transform 0.2s; }
  .service-card:hover .service-card__cta .icon { transform: translateX(4px); }
</style>
