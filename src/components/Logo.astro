---
interface Props {
  variant?: 'dark' | 'light';
  width?: number;
}
const { variant = 'dark', width = 180 } = Astro.props;
const logoFile = variant === 'light' ? '/logos/sincronia-logo-bg.png' : '/logos/sincronia-logo-transp.png';
---
<a href="/" aria-label="Sincronia Agency — Inicio" class="logo">
  <img src={logoFile} alt="Sincronia" width={width} height="auto" loading="eager" />
</a>
<style>
  .logo { display: inline-flex; align-items: center; transition: opacity 0.15s; }
  .logo:hover { opacity: 0.85; }
  .logo img { display: block; height: auto; }
</style>
