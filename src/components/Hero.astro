---
import MorphingText from '~/components/MorphingText.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** Texto fijo que va DESPUÉS del morphing (si se pasa titleMorphing). */
  titleSuffix?: string;
  /** Si se pasa, el h1 termina con un MorphingText que rota entre estos textos. */
  titleMorphing?: string[];
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'light' | 'dark';
  align?: 'left' | 'center';
}
const {
  eyebrow,
  title,
  titleSuffix,
  titleMorphing,
  subtitle,
  primaryCta,
  secondaryCta,
  variant = 'light',
  align = 'left',
} = Astro.props;
---
<section class:list={['hero', `hero--${variant}`, `hero--align-${align}`]}>
  <div class="container">
    {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
    <h1 class="hero__title">
      {title}
      {titleMorphing && (
        <>
          {' '}
          <MorphingText texts={titleMorphing} className="hero__morphing" />
          {titleSuffix && <> {titleSuffix}</>}
        </>
      )}
    </h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="hero__actions">
        {primaryCta && <a href={primaryCta.href} class="btn btn--primary btn--lg">{primaryCta.label}</a>}
        {secondaryCta && <a href={secondaryCta.href} class="btn btn--ghost btn--lg">{secondaryCta.label}</a>}
      </div>
    )}
  </div>
</section>

<style is:global>
  /* El morphing se renderiza inline, pero su .morphing-text es absolute.
     Lo convertimos en inline-block de la altura de la línea para que el h1
     no salte de tamaño. */
  .hero__title .morphing-text {
    display: inline-block;
    position: relative;
    color: var(--c-coral-500);
    vertical-align: baseline;
  }
  .hero--dark .hero__title .morphing-text { color: var(--c-coral-500); }
</style>
<style>
  .hero {
    padding-block: clamp(var(--s-16), 10vw, var(--s-24));
    position: relative;
    overflow: hidden;
  }
  .hero--light {
    background: linear-gradient(180deg, #fff 0%, var(--c-navy-50) 100%);
  }
  .hero--dark {
    background: var(--c-bg-dark);
    color: rgba(255,255,255,0.85);
  }
  .hero--dark .hero__title { color: #fff; }
  .hero--dark .hero__subtitle { color: rgba(255,255,255,0.7); }
  .hero--center { text-align: center; }
  .hero--center .hero__actions { justify-content: center; }
  .hero--center .hero__eyebrow { display: inline-block; }

  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-coral-700);
    background: var(--c-coral-50);
    padding: 0.35rem 0.75rem;
    border-radius: var(--r-full);
    margin-bottom: var(--s-5);
  }
  .hero--dark .hero__eyebrow { background: rgba(255,122,77,0.15); color: var(--c-coral-500); }

  .hero__title {
    margin-bottom: var(--s-5);
    max-width: 22ch;
  }
  .hero--center .hero__title { margin-inline: auto; }

  .hero__subtitle {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--c-muted);
    margin-bottom: var(--s-8);
    max-width: 60ch;
  }
  .hero--center .hero__subtitle { margin-inline: auto; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .hero--dark .btn--ghost { color: #fff; border-color: rgba(255,255,255,0.25); }
  .hero--dark .btn--ghost:hover { border-color: #fff; color: #fff; }
</style>
