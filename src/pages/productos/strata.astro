---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import CTA from '~/components/CTA.astro';
import FAQ from '~/components/FAQ.astro';
import PricingTable from '~/components/PricingTable.astro';
import { strata } from '~/content/products/strata';
import { products } from '~/data/products';
import { productJsonLd } from '~/lib/product-schema';
import { t } from '~/i18n/ui';
import { localizePath } from '~/lib/i18n';
import { assetUrl } from '~/lib/assets';

const c = strata.es;
const product = products.find((p) => p.slug === 'strata')!;
const productSchema = productJsonLd({
  productSlug: 'strata',
  name: c.hero.title,
  description: c.meta.description,
  locale: 'es',
  imagePath: '/productos/strata/logo-on-light-640.webp',
  faq: c.faq.items,
});
---
<Base title={c.meta.title} description={c.meta.description} jsonLd={productSchema}>
  <Hero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} />

  <section class="section product-identity" aria-label="Identidad de marca de Strata">
    <div class="container">
      <figure class="product-identity__figure">
        <picture>
          <source
            srcset={`${assetUrl('/productos/strata/pwa-256.webp')} 1x, ${assetUrl('/productos/strata/pwa-512.webp')} 2x`}
            type="image/webp"
          />
          <img
            src={assetUrl('/productos/strata/pwa.png')}
            alt="Strata — CMS con editor visual by Sincronia"
            width="256"
            height="256"
            loading="eager"
            decoding="async"
            class="product-identity__icon"
          />
        </picture>
        <figcaption class="product-identity__caption">Strata CMS <span class="product-identity__by">by Sincronia</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container intro-block">
      <h2>{c.intro.title}</h2>
      {c.intro.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="features-heading">
    <div class="container">
      <header class="section-header">
        <h2 id="features-heading">{c.features.title}</h2>
      </header>
      <ul class="features-list">
        {c.features.items.map((item) => (
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="icon icon--lg"><path d="M5 12l4 4L19 7"></path></svg>
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pricing-anchor" aria-labelledby="pricing-heading">
    <header class="section-header" style="text-align: center; max-width: 700px; margin: 0 auto var(--s-6);">
      <h2 id="pricing-heading">{c.pricing.title}</h2>
      <p class="lead" style="margin-top: var(--s-3);">{c.pricing.body}</p>
    </header>
    <PricingTable source={product} />
  </section>

  <FAQ title={c.faq.title} items={c.faq.items} />

  <CTA title={c.cta.title} subtitle={c.cta.subtitle} primaryCta={{ label: t('es', 'cta.demo'), href: localizePath('/contacto', 'es') }} />
</Base>

<style>
  .intro-block { max-width: 800px; }
  .intro-block h2 { margin-bottom: var(--s-5); }
  .intro-block p + p { margin-top: var(--s-4); }
  .section-header { max-width: 700px; margin-bottom: var(--s-10); }
  .features-list { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--s-5); max-width: 900px; margin: 0 auto; }
  @media (min-width: 768px) { .features-list { grid-template-columns: repeat(2, 1fr); } }
  .feature-item { display: flex; gap: var(--s-4); align-items: flex-start; padding: var(--s-5); background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-md); }
  .feature-item__icon { display: inline-flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; border-radius: var(--r-md); background: var(--c-navy-50); color: var(--c-navy-800); flex-shrink: 0; }
  .feature-item h3 { font-size: 1.0625rem; margin-bottom: 0.4rem; }
  .feature-item p { font-size: 0.9375rem; color: var(--c-muted); }
  .pricing-anchor { background: var(--c-bg-alt); border-block: 1px solid var(--c-line); }

  /* Identidad visual del producto: icono solo, sin lockup. El texto va como
     <figcaption> HTML con control tipográfico total. Evita el bleed del
     'by Sincronia' del PNG fuente. */
  .product-identity { padding-block: var(--s-8) var(--s-4); }
  .product-identity__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }
  .product-identity__icon {
    width: 10rem;
    height: 10rem;
    display: block;
  }
  .product-identity__caption {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .product-identity__by {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--c-muted);
    letter-spacing: 0;
    margin-top: 0.25rem;
  }
</style>
