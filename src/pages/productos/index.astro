---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import CTA from '~/components/CTA.astro';
import ProductCard from '~/components/ProductCard.astro';
import { products, getStartingPrice } from '~/data/products';
import { t } from '~/i18n/ui';
import { localizePath } from '~/lib/i18n';

const heroCopy = {
  es: { eyebrow: 'Productos propios', title: 'Software que hemos construido nosotros', subtitle: 'Un CRM y un CMS. Uno en beta con clientes, otro en alpha al que puedes apuntarte a la lista de espera.' },
  ca: { eyebrow: 'Productes propis', title: 'Programari que hem construït nosaltres', subtitle: 'Un CRM i un CMS. Un en beta amb clients, l\'altre en alpha on pots apuntar-te a la llista d\'espera.' },
  en: { eyebrow: 'Our products', title: 'Software we built ourselves', subtitle: 'A CRM and a CMS. One in beta with clients, the other in alpha you can join the waitlist for.' },
};

const descs: Record<string, Record<string, { tagline: string; desc: string }>> = {
  simplifica: {
    es: { tagline: 'CRM multi-sector', desc: 'El CRM que se adapta a tu sector, no al revés. Implementación personalizada para clínicas, asesorías, talleres y negocios con clientes y citas.' },
    ca: { tagline: 'CRM multi-sector', desc: "El CRM que s'adapta al teu sector, no a l'inrevés. Implementació personalitzada per a clíniques, assessories, tallers i negocis amb clients i cites." },
    en: { tagline: 'Multi-sector CRM', desc: 'A CRM that adapts to your sector, not the other way round. Custom implementation for clinics, consultancies, workshops and any business with clients and appointments.' },
  },
  strata: {
    es: { tagline: 'CMS con IA en alpha', desc: 'CMS propio con editor visual y asistente IA. Reduce el coste de tu web a la mitad. Apúntate a la lista de espera para acceso anticipado.' },
    ca: { tagline: 'CMS amb IA en alpha', desc: 'CMS propi amb editor visual i assistent IA. Redueix el cost del teu web a la meitat. Apunta\'t a la llista d\'espera per a accés anticipat.' },
    en: { tagline: 'AI-powered CMS in alpha', desc: 'Our own CMS with visual editor and AI assistant. Cuts your website cost in half. Join the waitlist for early access.' },
  },
};

const locale = Astro.url.pathname.startsWith('/ca/') ? 'ca' : Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const h = heroCopy[locale];
---
<Base
  title="Productos — Simplifica CRM y Strata CMS · Sincronia Agency"
  description="Simplifica (CRM multi-sector en beta) y Strata (CMS con IA en alpha): dos productos propios con implementación personalizada y hosting desde 20€/mes."
>
  <Hero eyebrow={h.eyebrow} title={h.title} subtitle={h.subtitle} />

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--2">
        {products.map((p) => {
          const d = descs[p.slug][locale];
          // Producto destacado (Strata) = variante navy para diferenciarse.
          const accent = p.featured ? 'navy' : 'coral';
          return (
            <ProductCard
              slug={p.slug}
              name={p.name}
              tagline={d.tagline}
              description={d.desc}
              status={p.status}
              featured={p.featured ?? false}
              priceFrom={getStartingPrice(p)}
              priceUnit="/mes"
              icon={p.icon}
              logo={p.logo}
              accent={accent as 'coral' | 'navy'}
            />
          );
        })}
      </div>
    </div>
  </section>

  <CTA
    title={locale === 'es' ? '¿Quieres que te enseñemos un producto a medida?' : locale === 'ca' ? 'Vols que t\'ensenyem un producte a mida?' : 'Want us to show you a tailored product?'}
    subtitle={locale === 'es' ? 'Hablemos 30 minutos y vemos si encaja con tu negocio. Sin coste.' : locale === 'ca' ? 'Parlem 30 minuts i veiem si encaixa amb el teu negoci. Sense cost.' : 'Let us talk for 30 minutes and see if it fits. No cost.'}
    primaryCta={{ label: t(locale, 'cta.contact'), href: localizePath('/contacto', locale) }}
  />
</Base>
