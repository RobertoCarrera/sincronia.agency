---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Button from '~/components/Button.astro';
import { nap } from '~/data/nap';

const content = {
  hero: { eyebrow: 'Contacte', title: 'Explica\'ns el teu projecte', subtitle: 'Et responem en menys de 24h. Sense compromís, sense formularis estranys. Si prefereixes trucar-nos, el telèfon també funciona.' },
  form: { name: 'Nom', email: 'Correu', phone: 'Telèfon (opcional)', company: 'Empresa (opcional)', service: 'Servei d\'interès', servicePlaceholder: 'Selecciona un servei', message: 'Explica\'ns breument el teu projecte', privacy: 'Accepto la política de privacitat i el tractament de les meves dades per rebre resposta a aquesta consulta.', submit: 'Enviar missatge', success: 'Gràcies! Et responem en menys de 24h.', error: 'Hi ha hagut un error. Escriu-nos directament a hola@sincronia.agency' },
  alt: { title: 'O si ho prefereixes', methods: [
    { label: 'Correu', value: nap.email, href: `mailto:${nap.email}` },
    { label: 'Telèfon', value: nap.phoneDisplay, href: `tel:${nap.phone.replace(/\s/g, '')}` },
    { label: 'Adreça', value: `${nap.street}, ${nap.postalCode} ${nap.city}`, href: null },
    { label: 'Horari', value: nap.schedule, href: null },
  ] },
};
---
<Base title="Contacte · Sincronia Agency" description="Contacta amb Sincronia Agency a Tarragona. Et responem en menys de 24h amb un pressupost sense compromís per al teu projecte web.">
  <Hero eyebrow={content.hero.eyebrow} title={content.hero.title} subtitle={content.hero.subtitle} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form-wrap">
        <form
          class="contact-form"
          action="https://formsubmit.co/hola@sincronia.agency"
          method="POST"
          aria-label="Formulari de contacte"
        >
          <input type="hidden" name="_subject" value="Nou contacte des de sincronia.agency" />
          <input type="hidden" name="_next" value="https://sincronia.agency/ca/gracies" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <div class="form-field">
            <label for="name-ca">{content.form.name} *</label>
            <input type="text" id="name-ca" name="Nom" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="email-ca">{content.form.email} *</label>
            <input type="email" id="email-ca" name="Correu" required autocomplete="email" />
          </div>
          <div class="form-field-row">
            <div class="form-field">
              <label for="phone-ca">{content.form.phone}</label>
              <input type="tel" id="phone-ca" name="Telèfon" autocomplete="tel" />
            </div>
            <div class="form-field">
              <label for="company-ca">{content.form.company}</label>
              <input type="text" id="company-ca" name="Empresa" autocomplete="organization" />
            </div>
          </div>
          <div class="form-field">
            <label for="service-ca">{content.form.service}</label>
            <select id="service-ca" name="Servei" data-slug-map='{"mantenimiento-wordpress":"Manteniment WordPress","desarrollo-wordpress":"Desenvolupament WordPress","desarrollo-aplicaciones-web":"Aplicació web","posicionamiento-seo":"SEO","hosting":"Hosting","simplifica":"Simplifica","strata":"Strata"}'>
              <option value="">{content.form.servicePlaceholder}</option>
              <option value="Manteniment WordPress">Manteniment WordPress</option>
              <option value="Desenvolupament WordPress">Desenvolupament WordPress</option>
              <option value="Aplicació web">Aplicació web (Angular, React, Vue)</option>
              <option value="SEO">Posicionament SEO</option>
              <option value="Hosting">Hosting</option>
              <option value="Simplifica">Simplifica (CRM)</option>
              <option value="Strata">Strata (CMS)</option>
              <option value="Altre">Altre</option>
            </select>
          </div>
          <div class="form-field">
            <label for="message-ca">{content.form.message} *</label>
            <textarea id="message-ca" name="Missatge" rows="5" required></textarea>
          </div>
          <div class="form-field form-field--check">
            <label class="checkbox-label">
              <input type="checkbox" name="Privacitat" required />
              <span>{content.form.privacy}</span>
            </label>
          </div>
          <Button type="submit" variant="primary" size="lg">{content.form.submit}</Button>
        </form>
      </div>

      <aside class="contact-alt" aria-label="Altres mètodes de contacte">
        <h2 class="contact-alt__title">{content.alt.title}</h2>
        <ul class="contact-alt__list">
          {content.alt.methods.map((m) => (
            <li class="contact-alt__item">
              <span class="contact-alt__label">{m.label}</span>
              {m.href ? <a href={m.href} class="contact-alt__value">{m.value}</a> : <span class="contact-alt__value">{m.value}</span>}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Pre-rellena el select de servei si la URL porta ?service={slug}
  // (l'usen les CTAs de les pàgines de servei / mega menu).
  const sel = document.querySelector<HTMLSelectElement>('select[name="Servei"]');
  if (sel) {
    const slug = new URLSearchParams(window.location.search).get('service');
    if (slug) {
      const mapAttr = sel.getAttribute('data-slug-map');
      if (mapAttr) {
        try {
          const map = JSON.parse(mapAttr) as Record<string, string>;
          const value = map[slug];
          if (value) sel.value = value;
        } catch { /* ignore */ }
      }
    }
  }
</script>

<style>
  .contact-grid { display: grid; gap: var(--s-10); grid-template-columns: 1fr; max-width: 1100px; margin: 0 auto; }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: 1.6fr 1fr; } }
  .contact-form { background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-lg); padding: var(--s-8); display: grid; gap: var(--s-4); }
  .form-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-field label { font-size: 0.875rem; font-weight: 500; color: var(--c-text); }
  .form-field input, .form-field select, .form-field textarea {
    padding: 0.7rem 0.875rem; border: 1px solid var(--c-line); border-radius: var(--r-md); font-size: 0.9375rem; color: var(--c-text); background: #fff; transition: border-color 0.15s;
    font-family: inherit;
  }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus { outline: none; border-color: var(--c-navy-800); box-shadow: 0 0 0 3px rgba(27,58,107,0.1); }
  .form-field-row { display: grid; gap: var(--s-4); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .form-field-row { grid-template-columns: 1fr 1fr; } }
  .form-field--check .checkbox-label { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.875rem; color: var(--c-muted); cursor: pointer; }
  .form-field--check input { margin-top: 0.2rem; flex-shrink: 0; }
  .contact-form .btn { justify-self: start; }
  .contact-alt { padding: var(--s-6); background: var(--c-navy-50); border-radius: var(--r-lg); }
  .contact-alt__title { font-size: 1.25rem; margin-bottom: var(--s-5); }
  .contact-alt__list { list-style: none; display: flex; flex-direction: column; gap: var(--s-4); }
  .contact-alt__item { display: flex; flex-direction: column; gap: 0.2rem; }
  .contact-alt__label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); font-weight: 600; }
  .contact-alt__value { font-size: 0.9375rem; color: var(--c-ink); font-weight: 500; }
  a.contact-alt__value:hover { color: var(--c-coral-500); }
</style>
