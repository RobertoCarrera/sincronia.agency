---
import Base from '~/layouts/Base.astro';
import ProductContactForm from '~/components/ProductContactForm.astro';
import { localizePath } from '~/lib/i18n';
import { strata as content } from '~/content/products/strata';
import { products } from '~/data/products';

const c = content.ca;
const productName = products.find((p) => p.slug === 'strata')!.name;
---
<Base title={`${productName} — Contacte per WhatsApp · Sincronia Agency`} description={`Escriu-nos per WhatsApp sobre ${productName} (CMS amb IA). Et responem en menys de 24h.`}>
  <section class="contact-product section">
    <div class="container">
      <header class="contact-product__header">
        <a href={localizePath('/productos/strata', 'ca')} class="contact-product__back">
          ← {c.hero.title}
        </a>
      </header>
      <ProductContactForm productSlug="strata" productName={productName} locale="ca" />
    </div>
  </section>
</Base>

<style>
  .contact-product { padding-block: var(--s-10) var(--s-12); }
  .contact-product__header { max-width: 720px; margin: 0 auto var(--s-6); }
  .contact-product__back {
    color: var(--c-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .contact-product__back:hover { color: var(--c-coral-500); }
</style>
