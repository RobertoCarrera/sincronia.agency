---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import CTA from '~/components/CTA.astro';
import FAQ from '~/components/FAQ.astro';
import PricingTable from '~/components/PricingTable.astro';
import { hosting } from '~/content/services/hosting';
import { services } from '~/data/services';
import { t } from '~/i18n/ui';
import { localizePath } from '~/lib/i18n';
import { serviceJsonLd } from '~/lib/service-schema';

const c = hosting.en;
const service = services.find((s) => s.slug === 'hosting')!;
const jsonLd = serviceJsonLd({ content: c, locale: 'en', slug: 'hosting' });
---
<Base title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <Hero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} />
  <section class="section">
    <div class="container intro-block">
      <h2>{c.intro.title}</h2>
      {c.intro.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section class="section section--alt" aria-labelledby="includes-heading">
    <div class="container">
      <header class="section-header">
        <h2 id="includes-heading">{c.includes.title}</h2>
      </header>
      <ul class="includes-list">
        {c.includes.items.map((item) => (
          <li class="include-item">
            <span class="include-item__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="icon"><path d="M5 12l4 4L19 7"></path></svg>
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <header class="section-header">
        <h2 id="process-heading">{c.process.title}</h2>
      </header>
      <ol class="process-list">
        {c.process.steps.map((step) => (
          <li class="process-step">
            <span class="process-step__num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {c.plugins && (
    <section class="section section--alt plugins-section" aria-labelledby="plugins-heading">
      <div class="container">
        <header class="section-header plugins-header">
          <span class="eyebrow">Included plus</span>
          <h2 id="plugins-heading">{c.plugins.title}</h2>
          <p class="lead">{c.plugins.subtitle}</p>
          <a href={localizePath('/hosting/plugins-premium', 'en')} class="plugins-detail-link">
            See full detail, official prices and estimated savings
            <svg viewBox="0 0 24 24" aria-hidden="true" class="plugins-detail-icon"><path d="M5 12h14M13 5l7 7-7 7" stroke-width="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <div class="plugins-grid">
          {c.plugins.categories.map((cat) => (
            <div class="plugin-category">
              <h3 class="plugin-category__title">{cat.name}</h3>
              <ul class="plugin-list">
                {cat.items.map((p) => (
                  <li class="plugin-item">
                    <span class="plugin-item__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="icon"><path d="M5 12l4 4L19 7"></path></svg>
                    </span>
                    <div>
                      <strong>{p.name}</strong>
                      <p>{p.desc}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="pricing-anchor" aria-labelledby="pricing-heading">
    <header class="section-header" style="text-align: center; max-width: 700px; margin: 0 auto var(--s-6);">
      <h2 id="pricing-heading">{c.pricing.title}</h2>
      <p class="lead" style="margin-top: var(--s-3);">{c.pricing.body}</p>
    </header>
    <PricingTable source={service} />
  </section>
  <FAQ title={c.faq.title} items={c.faq.items} />
  <CTA title={c.cta.title} subtitle={c.cta.subtitle} primaryCta={{ label: t('en', 'cta.quote'), href: localizePath('/contacto?service=hosting', 'en') }} />
</Base>

<style>
  .intro-block { max-width: 800px; }
  .intro-block h2 { margin-bottom: var(--s-5); }
  .intro-block p + p { margin-top: var(--s-4); }
  .section-header { max-width: 700px; margin-bottom: var(--s-10); }
  .includes-list { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--s-4); max-width: 900px; margin: 0 auto; }
  @media (min-width: 768px) { .includes-list { grid-template-columns: repeat(2, 1fr); gap: var(--s-5); } }
  .include-item { display: flex; gap: var(--s-4); align-items: flex-start; padding: var(--s-5); background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-md); }
  .include-item__check { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: var(--r-full); background: var(--c-coral-50); color: var(--c-coral-700); flex-shrink: 0; }
  .include-item__check .icon { width: 1.1rem; height: 1.1rem; stroke-width: 2.5; }
  .include-item h3 { font-size: 1.0625rem; margin-bottom: 0.4rem; }
  .include-item p { font-size: 0.9375rem; color: var(--c-muted); }
  .process-list { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--s-6); counter-reset: step; max-width: 900px; margin: 0 auto; }
  @media (min-width: 768px) { .process-list { grid-template-columns: repeat(2, 1fr); } }
  .process-step { position: relative; padding-left: var(--s-12); }
  .process-step__num { position: absolute; left: 0; top: -0.5rem; font-family: var(--font-mono); font-size: 2.5rem; font-weight: 700; color: var(--c-coral-500); line-height: 1; letter-spacing: -0.04em; }
  .process-step h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .process-step p { color: var(--c-muted); font-size: 0.9375rem; }
  .pricing-anchor { background: var(--c-bg-alt); border-block: 1px solid var(--c-line); }

  .plugins-header { text-align: center; max-width: 800px; margin: 0 auto var(--s-10); }
  .plugins-header .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-coral-700);
    margin-bottom: var(--s-3);
    font-weight: 600;
  }
  .plugins-header h2 { margin-bottom: var(--s-3); }
  .plugins-header .lead { color: var(--c-muted); }
  .plugins-detail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--s-4);
    color: var(--c-coral-700);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }
  .plugins-detail-link:hover { color: var(--c-coral-900); gap: 0.6rem; }
  .plugins-detail-icon { width: 1rem; height: 1rem; }
  .plugins-grid { display: grid; grid-template-columns: 1fr; gap: var(--s-5); max-width: 1100px; margin: 0 auto; }
  @media (min-width: 768px) { .plugins-grid { grid-template-columns: repeat(2, 1fr); } }
  .plugin-category {
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    padding: var(--s-5);
  }
  .plugin-category__title {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-coral-700);
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--c-line);
  }
  .plugin-list { list-style: none; display: flex; flex-direction: column; gap: var(--s-4); }
  .plugin-item { display: flex; gap: var(--s-3); align-items: flex-start; }
  .plugin-item__check { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: var(--r-full); background: var(--c-coral-50); color: var(--c-coral-700); flex-shrink: 0; margin-top: 0.15rem; }
  .plugin-item__check .icon { width: 0.85rem; height: 0.85rem; stroke-width: 2.5; }
  .plugin-item strong { display: block; color: var(--c-ink); font-size: 0.95rem; font-weight: 600; margin-bottom: 0.2rem; }
  .plugin-item p { color: var(--c-muted); font-size: 0.875rem; line-height: 1.5; margin: 0; }
</style>
